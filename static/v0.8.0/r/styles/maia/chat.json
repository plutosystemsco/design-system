{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "chat",
	"title": "Chat",
	"type": "registry:block",
	"author": "Pluto Systems <https://github.com/plutosystemsco/design-system>",
	"description": "A conversation: a log that follows new replies, turns with code, a composer that sends and stops, and the words a screen reader hears.",
	"devDependencies": [
		"phosphor-svelte@^3.1.1"
	],
	"registryDependencies": [
		"utils",
		"pluto-theme",
		"message-log",
		"message",
		"marker",
		"composer",
		"code-block",
		"empty",
		"alert",
		"button"
	],
	"meta": {
		"since": "0.6.0",
		"group": "blocks"
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import ChatPane from \"$COMPONENTS$/chat-pane.svelte\";\n  import type {\n    ChatMessage,\n    ChatStatus,\n  } from \"$COMPONENTS$/chat-types\";\n\n  // A stand-in for your server. Replace it: wire onsend to your transport,\n  // set status as the reply arrives, and set newReply when it finishes.\n  const REPLY = [\n    \"Here is one, with a docstring.\",\n    \"\",\n    \"```python\",\n    \"def add(a, b):\",\n    '    \"\"\"Add two numbers.\"\"\"',\n    \"    return a + b\",\n    \"```\",\n    \"\",\n    \"Call it with two numbers.\",\n  ].join(\"\\n\");\n\n  let messages = $state<ChatMessage[]>([]);\n  let status = $state<ChatStatus>(\"ready\");\n  let newReply = $state(false);\n  let run = 0;\n  let count = 0;\n  const sleep = (ms: number) =>\n    new Promise((resolve) => setTimeout(resolve, ms));\n\n  async function reply(): Promise<void> {\n    const id = ++run;\n    status = \"submitted\";\n    await sleep(700);\n    if (id !== run) return;\n    status = \"streaming\";\n    const turn: ChatMessage = {\n      id: `m${++count}`,\n      role: \"assistant\",\n      text: \"\",\n    };\n    messages.push(turn);\n    const last = messages.length - 1;\n    // Word by word, over about two seconds; the fence's newlines stay.\n    for (const token of REPLY.split(/(?<=\\s)/)) {\n      await sleep(60);\n      if (id !== run) return;\n      messages[last]!.text += token;\n    }\n    status = \"ready\";\n    newReply = true;\n  }\n\n  function onsend(text: string): void {\n    newReply = false;\n    messages.push({ id: `m${++count}`, role: \"user\", text });\n    void reply();\n  }\n\n  function onstop(): void {\n    run++;\n    status = \"ready\";\n    messages.push({ id: `m${++count}`, role: \"marker\", text: \"Stopped\" });\n  }\n\n  function onnew(): void {\n    run++;\n    messages = [];\n    status = \"ready\";\n    newReply = false;\n  }\n\n  function onretry(): void {\n    newReply = false;\n    void reply();\n  }\n</script>\n\n<svelte:head><title>Chat</title></svelte:head>\n\n<h1 class=\"sr-only\">Chat</h1>\n<ChatPane {messages} {status} {newReply} {onsend} {onstop} {onnew} {onretry} />\n",
			"type": "registry:page",
			"target": "chat/+page.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import Plus from \"phosphor-svelte/lib/Plus\";\n  import ChatTurn from \"$COMPONENTS$/chat-turn.svelte\";\n  import type {\n    ChatMessage,\n    ChatStatus,\n  } from \"$COMPONENTS$/chat-types\";\n  import * as Alert from \"$UI$/alert\";\n  import { Button } from \"$UI$/button\";\n  import { Composer } from \"$UI$/composer\";\n  import * as Empty from \"$UI$/empty\";\n  import * as Marker from \"$UI$/marker\";\n  import { MessageLog } from \"$UI$/message-log\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    messages,\n    status = \"ready\",\n    newReply = false,\n    title = \"New conversation\",\n    level = 2,\n    fill = \"screen\",\n    names,\n    value = $bindable(\"\"),\n    onsend,\n    onstop,\n    onnew,\n    onretry,\n    class: className,\n  }: {\n    messages: ChatMessage[];\n    status?: ChatStatus;\n    /** True once a reply has finished, until the next send: shows \"Latest reply\". */\n    newReply?: boolean;\n    title?: string;\n    /** The title's heading level; the turns are level 3, so 2 keeps the ranks in order. */\n    level?: 1 | 2 | 3 | 4 | 5 | 6;\n    /** `screen`: the viewport's height; `parent`: the height of a box the app sizes. */\n    fill?: \"screen\" | \"parent\";\n    names?: { user: string; assistant: string };\n    /** The composer's draft. */\n    value?: string;\n    onsend?: (text: string) => void;\n    onstop?: () => void;\n    onnew?: () => void;\n    onretry?: () => void;\n    class?: string;\n  } = $props();\n\n  let column: HTMLElement | null = $state(null);\n\n  /** Moves the reader to the last reply's heading; the view follows focus. */\n  function focusLatest(): void {\n    const headings = column?.querySelectorAll<HTMLElement>(\n      '[data-role=\"assistant\"] [data-slot=\"message-header\"]',\n    );\n    headings?.[headings.length - 1]?.focus();\n  }\n</script>\n\n<!--\n  A conversation: a 64 px header with the title and New chat; the log, which\n  fills the column and scrolls, following new replies; \"Latest reply\", shown\n  once a reply has finished, which moves the reader to it (the log's own\n  button moves the view); and the composer on the card ground behind a\n  groove, pinned at the bottom. Tokens stream silently (the log announces\n  nodes, not text); the composer's status says the three words; \"Responding\"\n  is a static line at the end of the log while a reply is awaited; an error\n  is an alert with Retry inside the log, with no server detail. A fixed\n  height, not a minimum: the log must overflow to scroll. The \"Latest reply\"\n  row keeps its 48 px while the button is hidden, so the log holds its height\n  when a reply ends.\n-->\n<div\n  data-slot=\"chat-pane\"\n  data-status={status}\n  class={cn(\n    \"flex flex-col bg-background\",\n    fill === \"screen\" ? \"h-dvh\" : \"h-full\",\n    className,\n  )}\n>\n  <div class=\"flex h-16 shrink-0 items-center justify-between gap-4 px-6\">\n    <svelte:element\n      this={`h${level}`}\n      data-slot=\"chat-title\"\n      class=\"font-heading text-base font-bold\"\n    >\n      {title}\n    </svelte:element>\n    <Button variant=\"secondary\" size=\"sm\" onclick={() => onnew?.()}>\n      <Plus aria-hidden=\"true\" />\n      New chat\n    </Button>\n  </div>\n\n  <!-- The log's wrapper (over which its button pins) is this row's flex child; the region fills it. -->\n  <div class=\"flex min-h-0 flex-1 flex-col *:min-h-0 *:flex-1\">\n    <MessageLog label=\"Messages\" busy={status === \"streaming\"} class=\"h-full\">\n      <div\n        bind:this={column}\n        data-slot=\"chat-column\"\n        class=\"mx-auto flex w-full max-w-prose flex-col gap-4 px-6 py-4\"\n      >\n        {#if messages.length === 0}\n          <Empty.Root>\n            <Empty.Header>\n              <Empty.Title level={3}>No messages yet</Empty.Title>\n              <Empty.Description\n                >Write a message below to start.</Empty.Description\n              >\n            </Empty.Header>\n          </Empty.Root>\n        {:else}\n          {#each messages as message (message.id)}\n            <ChatTurn {message} {names} />\n          {/each}\n        {/if}\n        {#if status === \"submitted\"}\n          <Marker.Root data-chat=\"responding\">\n            <Marker.Content>Responding</Marker.Content>\n          </Marker.Root>\n        {/if}\n        {#if status === \"error\"}\n          <Alert.Root variant=\"destructive\" role={null} data-chat=\"error\">\n            <Alert.Title>The reply could not be finished</Alert.Title>\n            <Alert.Description>\n              Try again, or write a new message.\n            </Alert.Description>\n            <Button\n              variant=\"secondary\"\n              size=\"sm\"\n              class=\"mt-2 justify-self-start\"\n              onclick={() => onretry?.()}\n            >\n              Retry\n            </Button>\n          </Alert.Root>\n        {/if}\n      </div>\n    </MessageLog>\n  </div>\n\n  <!-- The row is always there at its height, so the log does not resize when the button appears. -->\n  <div\n    class=\"mx-auto flex min-h-12 w-full max-w-prose shrink-0 items-center px-6\"\n  >\n    <Button\n      variant=\"secondary\"\n      size=\"sm\"\n      class={cn(!newReply && \"hidden\")}\n      onclick={focusLatest}\n    >\n      Latest reply\n    </Button>\n  </div>\n\n  <div class=\"groove shrink-0 bg-card px-6 py-4\">\n    <Composer\n      bind:value\n      {status}\n      {onsend}\n      {onstop}\n      class=\"mx-auto max-w-prose\"\n    />\n  </div>\n</div>\n",
			"type": "registry:component",
			"target": "chat-pane.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import ChatText from \"$COMPONENTS$/chat-text.svelte\";\n  import type { ChatMessage } from \"$COMPONENTS$/chat-types\";\n  import * as Marker from \"$UI$/marker\";\n  import * as Message from \"$UI$/message\";\n\n  let {\n    message,\n    names = { user: \"you\", assistant: \"assistant\" },\n  }: {\n    message: ChatMessage;\n    /** The mono headings over the turns; an app may pass the agent's name. */\n    names?: { user: string; assistant: string };\n  } = $props();\n</script>\n\n<!--\n  One turn: a user turn is a bubble at the end of the column, the\n  assistant's is plain prose; each headed by who spoke, a level 3 heading in\n  mono that \"Latest reply\" can focus. A marker is a separator line with its\n  text, such as \"Stopped\". No avatars: the mark is never the assistant's face.\n-->\n{#if message.role === \"marker\"}\n  <Marker.Root variant=\"separator\" data-chat=\"marker\">\n    <Marker.Content>{message.text}</Marker.Content>\n  </Marker.Root>\n{:else}\n  <Message.Root\n    align={message.role === \"user\" ? \"end\" : \"start\"}\n    data-chat=\"turn\"\n    data-role={message.role}\n  >\n    <Message.Group>\n      <Message.Header level={3}>{names[message.role]}</Message.Header>\n      <Message.Content variant={message.role === \"user\" ? \"bubble\" : \"plain\"}>\n        <ChatText text={message.text} />\n      </Message.Content>\n    </Message.Group>\n  </Message.Root>\n{/if}\n",
			"type": "registry:component",
			"target": "chat-turn.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  /** A run of prose, or one fenced block of code. */\n  export type ChatSegment =\n    | { kind: \"prose\"; text: string }\n    | { kind: \"code\"; language: string; code: string };\n\n  /**\n   * Splits text on fence lines. An opener is three backticks and any info\n   * string without a backtick (`python`, `c++`, `shell-session`,\n   * `python title=x`); its first word is the language. A closer is three\n   * backticks alone, with trailing whitespace allowed; a \"```lang\" line\n   * inside an open block is content. A `\\r` at a line's end is dropped, so\n   * CRLF text yields clean code. An open fence runs to the end of the\n   * string, so a streaming reply shows its block from the first fence line.\n   * No other markdown is read.\n   */\n  export function splitFences(text: string): ChatSegment[] {\n    const segments: ChatSegment[] = [];\n    let prose: string[] = [];\n    let code: string[] | null = null;\n    let language = \"\";\n    for (const raw of text.split(\"\\n\")) {\n      const line = raw.replace(/\\r$/, \"\");\n      if (code === null) {\n        const opener = /^```([^`]*)$/.exec(line);\n        if (opener) {\n          if (prose.join(\"\\n\").trim())\n            segments.push({ kind: \"prose\", text: prose.join(\"\\n\") });\n          prose = [];\n          code = [];\n          language = opener[1]!.trim().split(/\\s+/)[0] ?? \"\";\n          continue;\n        }\n      } else if (/^```\\s*$/.test(line)) {\n        segments.push({ kind: \"code\", language, code: code.join(\"\\n\") });\n        code = null;\n        continue;\n      }\n      (code ?? prose).push(line);\n    }\n    if (code !== null)\n      segments.push({ kind: \"code\", language, code: code.join(\"\\n\") });\n    else if (prose.join(\"\\n\").trim())\n      segments.push({ kind: \"prose\", text: prose.join(\"\\n\") });\n    return segments;\n  }\n\n  /** Prose into paragraphs, split on blank lines. */\n  export function paragraphs(text: string): string[] {\n    return text\n      .split(/\\n\\s*\\n/)\n      .map((p) => p.trim())\n      .filter(Boolean);\n  }\n</script>\n\n<script lang=\"ts\">\n  import * as CodeBlock from \"$UI$/code-block\";\n\n  let { text }: { text: string } = $props();\n\n  const segments = $derived(splitFences(text));\n</script>\n\n<!--\n  A turn's text: prose as paragraphs, each fenced block as a small code block\n  with its language (or \"code\") and a copy button, highlighted incrementally\n  as it streams. Headings are never rendered: text is prose, so no reply can\n  carry an h1. Markdown beyond a fence is the app's.\n-->\n{#each segments as segment, i (i)}\n  {#if segment.kind === \"prose\"}\n    {#each paragraphs(segment.text) as paragraph, j (j)}\n      <p class=\"whitespace-pre-wrap\">{paragraph}</p>\n    {/each}\n  {:else}\n    <CodeBlock.Root size=\"sm\" data-chat=\"code\">\n      <CodeBlock.Header>\n        <CodeBlock.Title>{segment.language || \"code\"}</CodeBlock.Title>\n        <CodeBlock.Actions>\n          <CodeBlock.CopyButton code={segment.code} />\n        </CodeBlock.Actions>\n      </CodeBlock.Header>\n      <CodeBlock.Content\n        code={segment.code}\n        language={segment.language || undefined}\n        lineNumbers={false}\n      />\n    </CodeBlock.Root>\n  {/if}\n{/each}\n",
			"type": "registry:component",
			"target": "chat-text.svelte"
		},
		{
			"content": "/** Who a turn is from, or a line that is not a turn (a \"Stopped\" marker). */\nexport type ChatRole = \"user\" | \"assistant\" | \"marker\";\n\n/** One message in a conversation. */\nexport type ChatMessage = { id: string; role: ChatRole; text: string };\n\n/** The chat's state: the Vercel AI SDK's four names, as the composer takes them. */\nexport type ChatStatus = \"ready\" | \"submitted\" | \"streaming\" | \"error\";\n",
			"type": "registry:component",
			"target": "chat-types.ts"
		}
	]
}