{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "four-dot",
	"title": "Four-dot mark",
	"type": "registry:ui",
	"author": "Pluto Systems <https://plutosystems.co>",
	"description": "The Pluto Systems four-dot mark and the wordmark lockup, sized by the text around them.",
	"registryDependencies": [
		"utils",
		"pluto-theme"
	],
	"meta": {
		"since": "0.1.0",
		"group": "foundation"
	},
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  export type FourDotTone = \"brand\" | \"mono\";\n\n  export type FourDotProps = HTMLAttributes<HTMLSpanElement> & {\n    /** `brand` paints the four mark colours; `mono` paints every dot `currentColor`. */\n    tone?: FourDotTone;\n    /** Names a mark that stands alone. Without it, the mark is decoration. */\n    label?: string;\n  };\n</script>\n\n<script lang=\"ts\">\n  import { cn } from \"$UTILS$\";\n\n  let {\n    tone = \"brand\",\n    label,\n    class: className,\n    ...rest\n  }: FourDotProps = $props();\n\n  // v2's order, never changed: top-left, top-right, bottom-left, bottom-right.\n  const brand = [\"bg-mark-1\", \"bg-mark-2\", \"bg-mark-3\", \"bg-mark-4\"];\n</script>\n\n<span\n  data-slot=\"four-dot\"\n  role={label ? \"img\" : undefined}\n  aria-label={label}\n  aria-hidden={label ? undefined : \"true\"}\n  class={cn(\"inline-grid grid-cols-2 gap-(--mark-gap)\", className)}\n  {...rest}\n>\n  {#each brand as colour, i (i)}\n    <span\n      data-slot=\"four-dot-dot\"\n      class={cn(\n        \"block size-(--mark-dot) rounded-full\",\n        tone === \"mono\" ? \"bg-current\" : colour,\n      )}\n    ></span>\n  {/each}\n</span>\n",
			"type": "registry:ui",
			"target": "four-dot/four-dot.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  import type { HTMLAnchorAttributes, HTMLAttributes } from \"svelte/elements\";\n  import type { FourDotTone } from \"./four-dot.svelte\";\n\n  export type LockupProps = HTMLAttributes<HTMLElement> &\n    Pick<HTMLAnchorAttributes, \"href\" | \"target\" | \"rel\"> & {\n      /** The link's accessible name, when `href` makes the lockup a link. It contains the visible word. */\n      label?: string;\n      tone?: FourDotTone;\n    };\n</script>\n\n<script lang=\"ts\">\n  import { cn } from \"$UTILS$\";\n  import FourDot from \"./four-dot.svelte\";\n\n  let {\n    href,\n    target,\n    rel,\n    label = \"Pluto Systems\",\n    tone = \"brand\",\n    class: className,\n    ...rest\n  }: LockupProps = $props();\n\n  const classes = $derived(\n    cn(\n      \"inline-flex items-baseline gap-(--mark-lockup-gap) font-heading font-bold tracking-mark leading-none\",\n      className,\n    ),\n  );\n</script>\n\n{#snippet content()}\n  pluto<FourDot {tone} class=\"-translate-y-(--mark-lift)\" />\n{/snippet}\n\n{#if href}\n  <a\n    data-slot=\"lockup\"\n    {href}\n    {target}\n    {rel}\n    aria-label={label}\n    class={classes}\n    {...rest}\n  >\n    {@render content()}\n  </a>\n{:else}\n  <span data-slot=\"lockup\" class={classes} {...rest}>\n    {@render content()}\n  </span>\n{/if}\n",
			"type": "registry:ui",
			"target": "four-dot/lockup.svelte"
		},
		{
			"content": "import FourDot from \"./four-dot.svelte\";\nimport Lockup from \"./lockup.svelte\";\n\nexport { FourDot, Lockup };\nexport type { FourDotProps, FourDotTone } from \"./four-dot.svelte\";\nexport type { LockupProps } from \"./lockup.svelte\";\n",
			"type": "registry:ui",
			"target": "four-dot/index.ts"
		}
	]
}