	"files": [
		{
			"content": "<script lang=\"ts\" module>\n  import { tv, type VariantProps } from \"tailwind-variants/lite\";\n\n  export const codeBlockVariants = tv({\n    // The root draws the focus indicator for its pre (002 decision 8's\n    // recipe), so overflow-hidden cannot clip it. The ground is the muted\n    // inset, with no border: an inset is told by its ground.\n    base: \"group/code-block relative flex w-full min-w-0 flex-col overflow-hidden rounded bg-muted text-sm has-[[data-slot=code-block-content]:focus-visible]:focus-ring data-[size=sm]:text-xs\",\n    variants: {\n      variant: {\n        default: \"text-foreground\",\n        // State told by colour: the app gives a destructive block a visible\n        // label, such as \"Error output\", in its header or beside it.\n        destructive: \"text-destructive\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n    },\n  });\n\n  export type CodeBlockVariant = VariantProps<\n    typeof codeBlockVariants\n  >[\"variant\"];\n  export type CodeBlockSize = \"default\" | \"sm\";\n</script>\n\n<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    variant = \"default\",\n    size = \"default\",\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n    variant?: CodeBlockVariant;\n    size?: CodeBlockSize;\n  } = $props();\n</script>\n\n<div\n  bind:this={ref}\n  data-slot=\"code-block\"\n  data-variant={variant}\n  data-size={size}\n  class={cn(codeBlockVariants({ variant }), className)}\n  {...restProps}\n>\n  {@render children?.()}\n</div>\n",
			"type": "registry:ui",
			"target": "code-block/code-block.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<!-- The header sits above the code, divided from it by the groove the content draws. -->\n<div\n  bind:this={ref}\n  data-slot=\"code-block-header\"\n  class={cn(\n    \"flex min-w-0 shrink-0 items-center justify-between gap-2 px-4 py-2 text-muted-foreground group-data-[size=sm]/code-block:px-3 group-data-[size=sm]/code-block:py-1 *:has-[>[data-slot=code-block-title]]:min-w-0\",\n    className,\n  )}\n  {...restProps}\n>\n  {@render children?.()}\n</div>\n",
			"type": "registry:ui",
			"target": "code-block/code-block-header.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<!-- An icon passed in is 16 px and decoration: give it aria-hidden=\"true\". -->\n<div\n  bind:this={ref}\n  data-slot=\"code-block-title\"\n  class={cn(\n    \"min-w-0 truncate font-sans text-sm font-medium group-data-[size=sm]/code-block:text-xs [&_svg]:pointer-events-none [&_svg]:me-1 [&_svg]:inline-block [&_svg]:align-middle [&_svg:not([class*='size-'])]:size-4\",\n    className,\n  )}\n  {...restProps}\n>\n  {@render children?.()}\n</div>\n",
			"type": "registry:ui",
