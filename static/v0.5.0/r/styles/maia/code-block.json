		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<!--\n  A row of controls, always visible. A control that appears on hover is\n  unreachable on touch and invisible until a keyboard user lands on it.\n-->\n<div\n  bind:this={ref}\n  data-slot=\"code-block-actions\"\n  class={cn(\"ms-auto flex shrink-0 items-center gap-1\", className)}\n  {...restProps}\n>\n  {@render children?.()}\n</div>\n",
			"type": "registry:ui",
			"target": "code-block/code-block-actions.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> = $props();\n</script>\n\n<!-- As the header, divided from the code above it by the groove. -->\n<div\n  bind:this={ref}\n  data-slot=\"code-block-footer\"\n  class={cn(\n    \"groove flex min-w-0 shrink-0 items-center justify-between gap-2 px-4 py-2 text-muted-foreground group-data-[size=sm]/code-block:px-3 group-data-[size=sm]/code-block:py-1\",\n    className,\n  )}\n  {...restProps}\n>\n  {@render children?.()}\n</div>\n",
			"type": "registry:ui",
			"target": "code-block/code-block-footer.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { onDestroy } from \"svelte\";\n  import Check from \"phosphor-svelte/lib/Check\";\n  import Copy from \"phosphor-svelte/lib/Copy\";\n  import { Button, type ButtonProps } from \"$UI$/button\";\n  import { Status } from \"$UI$/status\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    code,\n    variant = \"ghost\",\n    size = \"icon-sm\",\n    onclick,\n    ...restProps\n  }: Omit<ButtonProps, \"onclick\"> & {\n    /** The text copied: the block's code. */\n    code: string;\n    onclick?: (e: MouseEvent) => void;\n  } = $props();\n\n  let copied = $state(false);\n  let failed = $state(false);\n  let timeout: ReturnType<typeof setTimeout> | undefined;\n\n  function copy() {\n    // Absent in an insecure context (http:// other than localhost): nothing to do.\n    if (!navigator.clipboard) return;\n    failed = false;\n    navigator.clipboard\n      .writeText(code)\n      .then(() => {\n        copied = true;\n        clearTimeout(timeout);\n        timeout = setTimeout(() => (copied = false), 2000);\n      })\n      .catch(() => {\n        // The write was refused: the outcome is said, and the name stays\n        // \"Copy code\" so the button can be tried again.\n        copied = false;\n        failed = true;\n      });\n  }\n\n  onDestroy(() => clearTimeout(timeout));\n</script>\n\n<!--\n  A 32 px ghost button whose name says what it does, then \"Copied\" for two\n  seconds. The status region beside it is in the page from the first render,\n  so the announcement is heard (003 decision 8's rule); a refused write says\n  \"Could not copy\" there.\n-->\n<Button\n  bind:ref\n  data-slot=\"code-block-copy-button\"\n  data-copied={copied || undefined}\n  {variant}\n  {size}\n  aria-label={copied ? \"Copied\" : \"Copy code\"}\n  class={cn(className)}\n  onclick={(e) => {\n    onclick?.(e);\n    copy();\n  }}\n  {...restProps}\n>\n  {#if copied}\n    <Check aria-hidden=\"true\" />\n  {:else}\n    <Copy aria-hidden=\"true\" />\n  {/if}\n</Button>\n<Status text={copied ? \"Copied\" : failed ? \"Could not copy\" : \"\"} />\n",
			"type": "registry:ui",
			"target": "code-block/code-block-copy-button.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import { useHighlightedCode } from \"$HOOKS$/use-highlighted-code.svelte.js\";\n  import type { HighlightedLine } from \"$LIB$/highlighter\";\n  import CodeBlockLine from \"./code-block-line.svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    code,\n    lines,\n    language,\n    wrap = false,\n    lineNumbers = false,\n    tabindex = 0,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLPreElement>> & {\n    /** The code as text. Highlighted by the hook when `language` is given; split into lines when `lineNumbers` is set; else one text node. */\n    code?: string;\n    /** Pre-highlighted lines from `highlightCode`, for code rendered at prerender. Exactly one of `lines`, or `code` with `language`, drives the highlight. */\n    lines?: HighlightedLine[];\n    /** The language `code` is highlighted in. Without it, `code` renders plain. */\n    language?: string;\n    wrap?: boolean;\n    lineNumbers?: boolean;\n    /** 0 by default: the pre is a stop that scrolls by keyboard. Pass -1 to remove the stop. */\n    tabindex?: number;\n  } = $props();\n\n  // The hook loads nothing for an empty language, so a plain block costs no Shiki.\n  const highlighted = useHighlightedCode(\n    () => code ?? \"\",\n    () => language ?? \"\",\n  );\n\n  const rendered = $derived.by((): HighlightedLine[] | null => {\n    if (lines) return lines;\n    if (code === undefined) return null;\n    if (language) return highlighted.current;\n    if (lineNumbers) return code.replace(/\\n$/, \"\").split(\"\\n\");\n    return null;\n  });\n</script>\n\n{#snippet content()}\n  <code\n    data-slot=\"code-block-code\"\n    class=\"grid min-h-lh min-w-max content-start [counter-reset:line] in-data-numbered:grid-cols-[auto_1fr] in-data-wrap:min-w-0\"\n  >\n    {#if rendered}\n      {#each rendered as line, index (index)}\n        <CodeBlockLine code={line} />\n      {/each}\n    {:else if code !== undefined}\n      {code}\n    {:else}\n      {@render children?.()}\n    {/if}\n  </code>\n{/snippet}\n\n<!--\n  The one scroll container, with the scrollbar from tokens. Its focus\n  indicator is drawn by the root (002 decision 8's recipe), so it drops its\n  own. It draws the groove under a header. Whitespace inside a <pre> is rendered, so its\n  content is a snippet defined outside it, where Svelte trims whitespace.\n-->\n<!-- svelte-ignore a11y_no_noninteractive_tabindex -->\n<pre\n  bind:this={ref}\n  data-slot=\"code-block-content\"\n  data-wrap={wrap || undefined}\n  data-numbered={lineNumbers || undefined}\n  dir=\"ltr\"\n  {tabindex}\n  class={cn(\n    \"scrollbar min-h-0 min-w-0 overflow-auto px-4 py-3 text-start font-mono focus-visible:focus-ring-none group-data-[size=sm]/code-block:px-3 group-data-[size=sm]/code-block:py-2 group-has-data-[slot=code-block-header]/code-block:groove data-wrap:wrap-break-word data-wrap:whitespace-pre-wrap\",\n    className,\n  )}\n  {...restProps}>{@render content()}</pre>\n",
			"type": "registry:ui",
			"target": "code-block/code-block-content.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  import { tv, type VariantProps } from \"tailwind-variants/lite\";\n\n  // Every line carries a transparent marker of the focus width, so an\n  // emphasised line's coloured marker shifts no column. The three emphasised\n  // variants are the opaque card step with a marker in the state colour:\n  // shape and position, not a tint, which would vanish on the muted ground.\n  export const codeBlockLineVariants = tv({\n    base: \"relative block min-h-lh -mx-4 border-l-(length:--focus-width) border-transparent px-4 group-data-[size=sm]/code-block:-mx-3 group-data-[size=sm]/code-block:px-3 in-data-numbered:col-span-2 in-data-numbered:grid in-data-numbered:grid-cols-subgrid in-data-numbered:gap-x-3 in-data-numbered:[counter-increment:line] in-data-numbered:before:min-w-6 in-data-numbered:before:text-end in-data-numbered:before:text-muted-foreground in-data-numbered:before:select-none in-data-numbered:before:content-[counter(line)] in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_''] after:absolute after:top-0 after:start-1 after:select-none\",\n    variants: {\n      variant: {\n        default: \"\",\n        highlighted: \"bg-code-active-line border-primary\",\n        added:\n          \"bg-code-active-line border-success after:text-success after:content-['+']\",\n        removed:\n          \"bg-code-active-line border-destructive after:text-destructive after:content-['−']\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n    },\n  });\n\n  export type CodeBlockLineVariant = VariantProps<\n    typeof codeBlockLineVariants\n  >[\"variant\"];\n\n  /** One highlighted token, such as one returned by `useHighlightedCode` or `highlightCode`. */\n  export type CodeBlockLineToken = {\n    content: string;\n    class?: string;\n  };\n</script>\n\n<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    variant = \"default\",\n    code,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLSpanElement>> & {\n    variant?: CodeBlockLineVariant;\n    /** The line as plain text, or as highlighted tokens. When it is set, `children` is ignored. */\n    code?: string | CodeBlockLineToken[];\n  } = $props();\n\n  const newline = \"\\n\";\n</script>\n\n<!--\n  The line number is the `before` pseudo-element's counter, printed with an\n  empty alternative text, so it is neither copied nor read. An empty line holds\n  a newline so copying a selection keeps blank lines.\n-->\n<span\n  bind:this={ref}\n  data-slot=\"code-block-line\"\n  data-variant={variant}\n  class={cn(codeBlockLineVariants({ variant }), className)}\n  {...restProps}\n>\n  <span data-slot=\"code-block-line-content\" class=\"min-w-0\">\n    {#if typeof code === \"string\"}\n      {code || newline}\n    {:else if code?.length}\n      {#each code as token, index (index)}\n        <span class={token.class || undefined}>{token.content}</span>\n      {/each}\n    {:else if code}\n      {newline}\n    {:else if children}\n      {@render children()}\n    {:else}\n      {newline}\n    {/if}\n  </span>\n</span>\n",
			"type": "registry:ui",
			"target": "code-block/code-block-line.svelte"
		},
		{
			"content": "import Actions from \"./code-block-actions.svelte\";\nimport Content from \"./code-block-content.svelte\";\nimport CopyButton from \"./code-block-copy-button.svelte\";\nimport Footer from \"./code-block-footer.svelte\";\nimport Header from \"./code-block-header.svelte\";\nimport Title from \"./code-block-title.svelte\";\nimport Line, {\n  codeBlockLineVariants,\n  type CodeBlockLineToken,\n  type CodeBlockLineVariant,\n} from \"./code-block-line.svelte\";\nimport Root, {\n  codeBlockVariants,\n  type CodeBlockSize,\n  type CodeBlockVariant,\n} from \"./code-block.svelte\";\n\nexport {\n  Root,\n  Header,\n  Title,\n  Actions,\n  CopyButton,\n  Content,\n  Line,\n  Footer,\n  codeBlockVariants,\n  codeBlockLineVariants,\n  type CodeBlockVariant,\n  type CodeBlockSize,\n  type CodeBlockLineVariant,\n  type CodeBlockLineToken,\n  //\n  Root as CodeBlock,\n  Header as CodeBlockHeader,\n  Title as CodeBlockTitle,\n  Actions as CodeBlockActions,\n  CopyButton as CodeBlockCopyButton,\n  Content as CodeBlockContent,\n  Line as CodeBlockLine,\n  Footer as CodeBlockFooter,\n};\n",
			"type": "registry:ui",
			"target": "code-block/index.ts"
		}
	]
}