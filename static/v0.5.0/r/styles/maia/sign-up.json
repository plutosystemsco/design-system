{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "sign-up",
	"title": "Sign up",
	"type": "registry:block",
	"author": "Pluto Systems <https://plutosystems.co>",
	"description": "Email and a password with its rules written first, then a six-digit code on its own step, with resend.",
	"registryDependencies": [
		"utils",
		"pluto-theme",
		"card",
		"field",
		"input",
		"input-group",
		"input-otp",
		"button",
		"error-summary",
		"status"
	],
	"meta": {
		"since": "0.3.0",
		"group": "blocks"
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import SignUpForm, {\n    type SignUpField,\n    type SignUpResult,\n    type SignUpValues,\n  } from \"$COMPONENTS$/sign-up-form.svelte\";\n  import SignUpVerify, {\n    MESSAGES,\n    type SignUpCodeResult,\n  } from \"$COMPONENTS$/sign-up-verify.svelte\";\n  import { Button } from \"$UI$/button\";\n  import { titleFor } from \"$UI$/error-summary\";\n\n  let step = $state<\"details\" | \"verify\" | \"done\">(\"details\");\n  let email = $state(\"\");\n  let returning = $state(false);\n  let errors = $state<Partial<Record<SignUpField, string>>>({});\n  let formError = $state<string>();\n  let codeErrors = $state<{ code?: string }>({});\n  let codeFormError = $state<string>();\n  let done = $state<HTMLElement | null>(null);\n\n  const title = $derived(\n    step === \"details\"\n      ? \"Create an account\"\n      : step === \"verify\"\n        ? \"Check your email\"\n        : \"Your account is ready\",\n  );\n  const failed = $derived(\n    step === \"details\"\n      ? Object.values(errors).some(Boolean) || Boolean(formError)\n      : step === \"verify\"\n        ? Boolean(codeErrors.code) || Boolean(codeFormError)\n        : false,\n  );\n\n  // A stand-in for your server. Replace it.\n  async function createAccount(values: SignUpValues): Promise<SignUpResult> {\n    void values;\n    await new Promise((resolve) => setTimeout(resolve, 800));\n    return { ok: true };\n  }\n\n  // A stand-in for your server. Replace it. The right code is 123456.\n  async function verifyCode(code: string): Promise<SignUpCodeResult> {\n    await new Promise((resolve) => setTimeout(resolve, 800));\n    return code === \"123456\"\n      ? { ok: true }\n      : { ok: false, errors: { code: MESSAGES.codeWrong } };\n  }\n\n  // A stand-in for your server. Replace it.\n  async function resendCode(): Promise<void> {\n    await new Promise((resolve) => setTimeout(resolve, 400));\n  }\n\n  async function details(values: SignUpValues): Promise<SignUpResult> {\n    const result = await createAccount(values);\n    if (result.ok) step = \"verify\";\n    return result;\n  }\n\n  async function verify(code: string): Promise<SignUpCodeResult> {\n    const result = await verifyCode(code);\n    if (result.ok) step = \"done\";\n    return result;\n  }\n\n  function changeEmail() {\n    returning = true;\n    codeErrors = {};\n    codeFormError = undefined;\n    step = \"details\";\n  }\n\n  // The new step replaces the form under focus; its heading takes focus.\n  $effect(() => {\n    if (step === \"done\") done?.focus();\n  });\n</script>\n\n<svelte:head><title>{titleFor(title, failed)}</title></svelte:head>\n\n<div class=\"flex min-h-svh justify-center px-6 py-16 sm:items-center\">\n  {#if step === \"details\"}\n    <SignUpForm\n      class=\"w-full max-w-sm\"\n      onsubmit={details}\n      focusOnMount={returning}\n      bind:email\n      bind:errors\n      bind:formError\n    />\n  {:else if step === \"verify\"}\n    <SignUpVerify\n      class=\"w-full max-w-sm\"\n      {email}\n      onsubmit={verify}\n      onresend={resendCode}\n      onchangeemail={changeEmail}\n      focusOnMount\n      bind:errors={codeErrors}\n      bind:formError={codeFormError}\n    />\n  {:else}\n    <div class=\"flex w-full max-w-sm flex-col gap-6\">\n      <h1\n        bind:this={done}\n        tabindex=\"-1\"\n        class=\"font-heading text-2xl font-bold tracking-section text-foreground\"\n      >\n        Your account is ready\n      </h1>\n      <p class=\"text-muted-foreground\">\n        The account for {email} is ready to use.\n      </p>\n      <Button href=\"/\" class=\"w-full\">Continue</Button>\n    </div>\n  {/if}\n</div>\n",
			"type": "registry:page",
			"target": "sign-up/+page.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  export type SignUpField = \"email\" | \"password\";\n  export type SignUpValues = { email: string; password: string };\n  export type SignUpResult =\n    | { ok: true }\n    | {\n        ok: false;\n        errors?: Partial<Record<SignUpField, string>>;\n        formError?: string;\n      };\n\n  /** The house wording, for the states the app's server reports too. */\n  export const MESSAGES = {\n    /** When the callback throws or rejects. */\n    failed: \"We could not create your account. Try again.\",\n    emailEmpty: \"Enter your email address\",\n    emailFormat: \"Enter an email address like name@example.com\",\n    emailUnavailable:\n      \"That email address cannot be used for a new account. Use a different address, or sign in if it is yours.\",\n    passwordEmpty: \"Enter a password\",\n    passwordShort: (min: number) =>\n      `Use at least ${min} characters for your password`,\n    rules: (min: number) =>\n      `Use at least ${min} characters. A few words together make a password you can remember.`,\n  } as const;\n</script>\n\n<script lang=\"ts\">\n  import { onMount, tick, type Snippet } from \"svelte\";\n  import { Button } from \"$UI$/button\";\n  import * as Card from \"$UI$/card\";\n  import { ErrorSummary } from \"$UI$/error-summary\";\n  import * as Field from \"$UI$/field\";\n  import { Input } from \"$UI$/input\";\n  import { InputGroupPassword } from \"$UI$/input-group\";\n  import { Status } from \"$UI$/status\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    onsubmit,\n    email = $bindable(\"\"),\n    password = $bindable(\"\"),\n    errors = $bindable({}),\n    formError = $bindable(),\n    busy = $bindable(false),\n    passwordMinLength = 15,\n    termsHref,\n    privacyHref,\n    focusOnMount = false,\n    title = \"Create an account\",\n    description = \"You need an email address. We send a code to it to check that it is yours.\",\n    level = 1,\n    idPrefix = \"sign-up\",\n    footer,\n    class: className,\n  }: {\n    onsubmit: (values: SignUpValues) => Promise<SignUpResult>;\n    email?: string;\n    password?: string;\n    errors?: Partial<Record<SignUpField, string>>;\n    formError?: string;\n    busy?: boolean;\n    /** The fewest characters a password may have: 15 or more, never fewer. */\n    passwordMinLength?: number;\n    /** The terms of service. Without it, no consent sentence renders. */\n    termsHref?: string;\n    /** The privacy notice, named in the consent sentence when given. */\n    privacyHref?: string;\n    /** Moves focus to the title on mount, for a return from the code step. */\n    focusOnMount?: boolean;\n    title?: string;\n    description?: string;\n    level?: 1 | 2 | 3 | 4 | 5 | 6;\n    idPrefix?: string;\n    /** The app's own links, such as \"Sign in instead\". */\n    footer?: Snippet;\n    class?: string;\n  } = $props();\n\n  // NIST SP 800-63B-4: 15 when the password is the only factor. An app may\n  // raise the floor, never lower it. No upper limit, no composition rule.\n  const min = $derived(Math.max(15, passwordMinLength));\n\n  let announce = $state(false);\n  // What the status says once the callback has answered.\n  let notice = $state(\"\");\n  let summary = $state<HTMLElement | null>(null);\n  let heading = $state<HTMLElement | null>(null);\n\n  const ids = $derived({\n    email: `${idPrefix}-email`,\n    password: `${idPrefix}-password`,\n  });\n  const links = $derived(\n    ([\"email\", \"password\"] as const)\n      .filter((field) => errors[field])\n      .map((field) => ({ id: ids[field], message: errors[field]! })),\n  );\n\n  onMount(() => {\n    if (focusOnMount) heading?.focus();\n  });\n\n  function validate(): Partial<Record<SignUpField, string>> {\n    const value = email.trim();\n    return {\n      email: !value\n        ? MESSAGES.emailEmpty\n        : /^[^@\\s]+@[^@\\s]+$/.test(value)\n          ? undefined\n          : MESSAGES.emailFormat,\n      password: !password\n        ? MESSAGES.passwordEmpty\n        : password.length < min\n          ? MESSAGES.passwordShort(min)\n          : undefined,\n    };\n  }\n\n  async function failed() {\n    announce = true;\n    await tick();\n    summary?.focus();\n  }\n\n  async function submit(event: SubmitEvent) {\n    event.preventDefault();\n    if (busy) return;\n    const found = validate();\n    if (found.email || found.password) {\n      errors = found;\n      formError = undefined;\n      notice = \"\";\n      return failed();\n    }\n    errors = {};\n    formError = undefined;\n    notice = \"\";\n    busy = true;\n    let result: SignUpResult;\n    try {\n      result = await onsubmit({ email: email.trim(), password });\n    } catch {\n      // A callback that throws keeps what was typed and says so.\n      busy = false;\n      formError = MESSAGES.failed;\n      notice = MESSAGES.failed;\n      return failed();\n    } finally {\n      busy = false;\n    }\n    if (result.ok) return;\n    errors = result.errors ?? {};\n    formError = result.formError;\n    if (formError) password = \"\";\n    return failed();\n  }\n\n  // inline-block: the box is the 25.6 px line, so each link meets 24 px.\n  const link = \"inline-block text-primary underline underline-offset-4\";\n</script>\n\n<!--\n  Sign up, the details step: email and a password, with the rules written\n  before the field. Consent is a sentence under the button, shown only when\n  the app gives its terms.\n-->\n<Card.Root\n  class={cn(\n    \"max-sm:overflow-visible max-sm:border-0 max-sm:bg-transparent max-sm:py-0\",\n    className,\n  )}\n>\n  <Card.Header class=\"max-sm:px-0\">\n    <Card.Title\n      bind:ref={heading}\n      {level}\n      tabindex={-1}\n      class=\"text-2xl tracking-section\">{title}</Card.Title\n    >\n    <Card.Description>{description}</Card.Description>\n  </Card.Header>\n  <Card.Content class=\"max-sm:px-0\">\n    <form\n      novalidate\n      data-slot=\"sign-up-form\"\n      class=\"grid gap-6\"\n      onsubmit={submit}\n    >\n      <ErrorSummary\n        bind:ref={summary}\n        {announce}\n        errors={links}\n        message={formError}\n      />\n      <Field.Field id={ids.email} error={errors.email}>\n        <Field.Label>Email address</Field.Label>\n        <Input\n          type=\"email\"\n          autocomplete=\"email\"\n          spellcheck={false}\n          autocapitalize=\"off\"\n          bind:value={email}\n        />\n      </Field.Field>\n      <Field.Field\n        id={ids.password}\n        error={errors.password}\n        description={MESSAGES.rules(min)}\n        class=\"*:data-[slot=field-description]:order-first *:data-[slot=field-label]:order-first\"\n      >\n        <Field.Label>Create a password</Field.Label>\n        <InputGroupPassword autocomplete=\"new-password\" bind:value={password} />\n      </Field.Field>\n      <Button type=\"submit\" {busy} class=\"w-full\">Create account</Button>\n      {#if termsHref}\n        <p data-slot=\"sign-up-consent\" class=\"text-base text-muted-foreground\">\n          By creating an account, you agree to the\n          <a href={termsHref} class={link}>terms of service</a\n          >{#if privacyHref}{\" \"}and the\n            <a href={privacyHref} class={link}>privacy notice</a>{/if}.\n        </p>\n      {/if}\n      <Status text={busy ? \"Creating your account…\" : notice} />\n    </form>\n  </Card.Content>\n  {#if footer}\n    <Card.Footer class=\"max-sm:px-0\">{@render footer()}</Card.Footer>\n  {/if}\n</Card.Root>\n",
			"type": "registry:component",
			"target": "sign-up-form.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  export type SignUpCodeResult =\n    | { ok: true }\n    | { ok: false; errors?: { code?: string }; formError?: string };\n\n  /** The house wording, for the states the app's server reports too. */\n  export const MESSAGES = {\n    /** When the callback throws or rejects. */\n    failed: \"We could not check the code. Try again.\",\n    /** When the resend callback throws or rejects. */\n    resendFailed: \"We could not send a new code. Try again.\",\n    codeEmpty: \"Enter the 6-digit code from the email\",\n    codeIncomplete: \"Enter all 6 digits of the code\",\n    codeWrong: \"That code is not right. Check the email, or send a new code.\",\n    tooManyAttempts: \"Too many attempts. Wait a while, then try again.\",\n  } as const;\n</script>\n\n<script lang=\"ts\">\n  import { onMount, tick } from \"svelte\";\n  import { Button } from \"$UI$/button\";\n  import * as Card from \"$UI$/card\";\n  import { ErrorSummary } from \"$UI$/error-summary\";\n  import * as Field from \"$UI$/field\";\n  import * as InputOTP from \"$UI$/input-otp\";\n  import { Status } from \"$UI$/status\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    email,\n    onsubmit,\n    onresend,\n    onchangeemail,\n    code = $bindable(\"\"),\n    errors = $bindable({}),\n    formError = $bindable(),\n    busy = $bindable(false),\n    focusOnMount = false,\n    level = 1,\n    idPrefix = \"sign-up\",\n    title = \"Check your email\",\n    class: className,\n  }: {\n    /** Shown, never asked for again. */\n    email: string;\n    onsubmit: (code: string) => Promise<SignUpCodeResult>;\n    onresend: () => Promise<void>;\n    onchangeemail: () => void;\n    code?: string;\n    errors?: { code?: string };\n    formError?: string;\n    busy?: boolean;\n    /** Moves focus to the title on mount, when the step changes. */\n    focusOnMount?: boolean;\n    level?: 1 | 2 | 3 | 4 | 5 | 6;\n    idPrefix?: string;\n    title?: string;\n    class?: string;\n  } = $props();\n\n  let announce = $state(false);\n  let summary = $state<HTMLElement | null>(null);\n  let heading = $state<HTMLElement | null>(null);\n  let resending = $state(false);\n  let sent = $state(0);\n  let notice = $state(\"\");\n\n  const id = $derived(`${idPrefix}-code`);\n  const links = $derived(errors.code ? [{ id, message: errors.code }] : []);\n\n  onMount(() => {\n    if (focusOnMount) heading?.focus();\n  });\n\n  async function failed() {\n    announce = true;\n    await tick();\n    summary?.focus();\n  }\n\n  async function submit(event: SubmitEvent) {\n    event.preventDefault();\n    if (busy) return;\n    if (code.length < 6) {\n      notice = \"\";\n      errors = {\n        code: code ? MESSAGES.codeIncomplete : MESSAGES.codeEmpty,\n      };\n      formError = undefined;\n      return failed();\n    }\n    errors = {};\n    formError = undefined;\n    notice = \"\";\n    busy = true;\n    let result: SignUpCodeResult;\n    try {\n      result = await onsubmit(code);\n    } catch {\n      // A callback that throws keeps the code and says so.\n      busy = false;\n      formError = MESSAGES.failed;\n      notice = MESSAGES.failed;\n      return failed();\n    } finally {\n      busy = false;\n    }\n    if (result.ok) return;\n    errors = result.errors ?? {};\n    formError = result.formError;\n    return failed();\n  }\n\n  // Each resend says it is working, then what it did, worded differently\n  // after the first, so the region changes and is announced every time.\n  async function resend() {\n    if (resending) return;\n    resending = true;\n    notice = \"Sending a new code…\";\n    try {\n      await onresend();\n      notice =\n        sent === 0\n          ? `We sent a new code to ${email}.`\n          : `We sent another code to ${email}.`;\n      sent++;\n    } catch {\n      notice = MESSAGES.resendFailed;\n    } finally {\n      resending = false;\n    }\n  }\n</script>\n\n<!--\n  Sign up, the code step: the six-digit code, pasted or typed, on its own\n  step. Below sm the cells are 32 px squares, so six fit a 320 px screen.\n-->\n<Card.Root\n  class={cn(\n    \"max-sm:overflow-visible max-sm:border-0 max-sm:bg-transparent max-sm:py-0\",\n    className,\n  )}\n>\n  <Card.Header class=\"max-sm:px-0\">\n    <Card.Title\n      bind:ref={heading}\n      {level}\n      tabindex={-1}\n      class=\"text-2xl tracking-section\">{title}</Card.Title\n    >\n    <Card.Description>\n      We sent a 6-digit code to {email}. Enter it below to finish creating your\n      account.\n    </Card.Description>\n  </Card.Header>\n  <Card.Content class=\"max-sm:px-0\">\n    <form\n      novalidate\n      data-slot=\"sign-up-verify\"\n      class=\"grid gap-6\"\n      onsubmit={submit}\n    >\n      <ErrorSummary\n        bind:ref={summary}\n        {announce}\n        errors={links}\n        message={formError}\n      />\n      <Field.Field\n        {id}\n        error={errors.code}\n        description=\"You can paste the whole code.\"\n      >\n        <Field.Label>Verification code</Field.Label>\n        <InputOTP.Root bind:value={code}>\n          {#snippet children({ cells })}\n            <InputOTP.Group>\n              {#each cells.slice(0, 3) as cell, i (i)}\n                <InputOTP.Slot {cell} class=\"max-sm:size-8\" />\n              {/each}\n            </InputOTP.Group>\n            <InputOTP.Separator />\n            <InputOTP.Group>\n              {#each cells.slice(3, 6) as cell, i (i)}\n                <InputOTP.Slot {cell} class=\"max-sm:size-8\" />\n              {/each}\n            </InputOTP.Group>\n          {/snippet}\n        </InputOTP.Root>\n      </Field.Field>\n      <div class=\"flex flex-col gap-3\">\n        <Button type=\"submit\" {busy} class=\"w-full\">Verify email</Button>\n        <Button\n          variant=\"secondary\"\n          busy={resending}\n          class=\"w-full\"\n          onclick={resend}>Send a new code</Button\n        >\n        <Button variant=\"link\" class=\"self-start\" onclick={onchangeemail}\n          >Use a different email address</Button\n        >\n      </div>\n      <Status text={busy ? \"Checking the code…\" : notice} />\n    </form>\n  </Card.Content>\n</Card.Root>\n",
			"type": "registry:component",
			"target": "sign-up-verify.svelte"
		}
	]
}