{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "pluto-theme",
	"title": "Pluto theme",
	"type": "registry:theme",
	"author": "Pluto Systems <https://github.com/plutosystemsco/design-system>",
	"description": "The Pluto Systems tokens for light and dark: colour, radius, spacing, type, motion, focus and the groove.",
	"devDependencies": [
		"shadcn-svelte@^1.7.1"
	],
	"registryDependencies": [
		"font-geist",
		"font-heading-ibm-plex-sans",
		"font-jetbrains-mono"
	],
	"meta": {
		"since": "0.1.0",
		"group": "foundation",
		"modes": [
			"productive",
			"expressive"
		]
	},
	"css": {
		":root": {
			"--mark-dot": "0.3em",
			"--mark-gap": "0.08em",
			"--mark-rise": "0.36em",
			"--mark-lockup-gap": "0.1em",
			"--mark-lockup-scale": "0.87",
			"--mark-lockup-size": "calc(var(--mark-lockup-scale) * 1em)",
			"--mark-lift": "calc(var(--mark-rise) + var(--mark-dot) + var(--mark-gap))",
			"--mark-orbit": "0.5em",
			"--motion-entrance": "900ms",
			"--motion-micro": "200ms",
			"--motion-entrance-dot": "0.55",
			"--motion-entrance-start": "0.15",
			"--motion-entrance-stagger": "0.1",
			"--line-width": "1px",
			"--focus-width": "2px",
			"--focus-offset": "2px",
			"--font-face-display": "'IBM Plex Sans Variable', system-ui, sans-serif",
			"--type-display-size": "clamp(3rem, 6vw, 5.75rem)",
			"--type-display-leading": "0.95",
			"--type-display-tracking": "-0.045em",
			"--type-section-size": "clamp(2.25rem, 4vw, 3.5rem)",
			"--type-section-leading": "1.05",
			"--type-section-tracking": "-0.035em",
			"--type-proof-size": "clamp(3.5rem, 6vw, 6rem)",
			"--type-proof-leading": "1",
			"--type-proof-tracking": "-0.04em",
			"--type-poster-size": "clamp(3.5rem, 12vw, 10rem)",
			"--type-poster-leading": "0.9",
			"--type-poster-tracking": "-0.05em",
			"--motion-press": "160ms",
			"--motion-slide": "220ms",
			"--motion-busy": "400ms",
			"--motion-reveal": "600ms",
			"--motion-fill": "700ms",
			"--motion-light": "600ms",
			"--ease-standard": "cubic-bezier(0.2, 0.7, 0.2, 1)",
			"--ease-spring": "linear(0, 0.0391, 0.1362, 0.2654, 0.407, 0.5466, 0.6745, 0.7852, 0.876, 0.9467, 0.9985, 1.0338, 1.0552, 1.0657, 1.068, 1.0646, 1.0575, 1.0485, 1.0388, 1.0294, 1.0208, 1.0135, 1.0076, 1.003, 0.9996, 0.9974, 0.9961, 0.9955, 0.9954, 0.9957, 0.9962, 0.9968, 1)",
			"--press-scale": "0.98",
			"--radius-action": "var(--radius)",
			"--size-bar": "4.5rem",
			"--size-action": "3.25rem",
			"--size-action-small": "2.375rem",
			"--size-track": "0.375rem",
			"--size-hero-fill": "calc(100svh - var(--size-bar))",
			"--gutter-stage": "clamp(1rem, 4vw, 3.5rem)",
			"--field-1": "#2D48D4",
			"--field-1-foreground": "#FFFFFF",
			"--field-2": "#C92035",
			"--field-2-foreground": "#FFFFFF",
			"--field-3": "#E2B000",
			"--field-3-foreground": "#0B0F17",
			"--field-4": "#008058",
			"--field-4-foreground": "#FFFFFF",
			"--surface-foreground": "var(--foreground)",
			"--surface-muted-foreground": "var(--muted-foreground)",
			"--surface-card-foreground": "var(--card-foreground)",
			"--surface-primary": "var(--primary)",
			"--surface-ring": "var(--ring)",
			"--surface-primary-foreground": "var(--primary-foreground)",
			"--surface-border": "var(--border)",
			"--glass-tint": "#F3F0E8DB",
			"--glass-rim": "#FFFFFFCC",
			"--glass-edge": "#0B0F1714",
			"--glass-fallback": "#FBFAF6",
			"--glass-light": "#FFFFFF8C",
			"--glass-shadow": "0 1px 0 #0B0F170F, 0 16px 32px -16px #0B0F1747",
			"--glass-blur": "16px",
			"color-scheme": "light"
		},
		".dark": {
			"--field-1": "#93B0FF",
			"--field-1-foreground": "#16140F",
			"--field-2": "#FF9491",
			"--field-2-foreground": "#16140F",
			"--field-3": "#F8D874",
			"--field-3-foreground": "#16140F",
			"--field-4": "#60C498",
			"--field-4-foreground": "#16140F",
			"--surface-foreground": "var(--foreground)",
			"--surface-muted-foreground": "var(--muted-foreground)",
			"--surface-card-foreground": "var(--card-foreground)",
			"--surface-primary": "var(--primary)",
			"--surface-ring": "var(--ring)",
			"--surface-primary-foreground": "var(--primary-foreground)",
			"--surface-border": "var(--border)",
			"--glass-tint": "#16140FD6",
			"--glass-rim": "#FFFFFF1F",
			"--glass-edge": "#FFFFFF14",
			"--glass-fallback": "#221F19",
			"--glass-light": "#FFFFFF33",
			"--glass-shadow": "0 1px 0 #00000000, 0 16px 32px -16px #000000B3",
			"color-scheme": "dark"
		},
		"@media (prefers-reduced-motion: reduce)": {
			"html:root": {
				"--motion-entrance": "0ms",
				"--motion-micro": "0ms",
				"--motion-press": "0ms",
				"--motion-slide": "0ms",
				"--motion-busy": "0ms",
				"--motion-reveal": "0ms",
				"--motion-fill": "0ms",
				"--motion-light": "0ms",
				"--press-scale": "1"
			},
			"*, ::before, ::after": {
				"animation-duration": "0.01ms !important",
				"animation-iteration-count": "1 !important",
				"transition-duration": "0.01ms !important",
				"scroll-behavior": "auto !important"
			},
			".mark-entrance [data-slot=\"four-dot-dot\"]": {
				"animation": "none"
			}
		},
		"@utility groove": {
			"border-top": "var(--line-width) solid var(--groove-line)",
			"box-shadow": "inset 0 var(--line-width) 0 var(--groove-light)"
		},
		"@utility focus-ring": {
			"outline": "var(--focus-width) solid var(--ring)",
			"outline-offset": "var(--focus-offset)"
		},
		"@utility focus-ring-none": {
			"outline": "none"
		},
		"@utility scrollbar": {
			"scrollbar-color": "var(--input) var(--muted)",
			"scrollbar-width": "thin"
		},
		"@utility scrollbar-code": {
			"scrollbar-color": "var(--input) var(--code-background)",
			"scrollbar-width": "thin"
		},
		"@utility groove-s": {
			"border-inline-start": "var(--line-width) solid var(--groove-line)",
			"box-shadow": "inset var(--line-width) 0 0 var(--groove-light)"
		},
		"@utility groove-b": {
			"border-bottom": "var(--line-width) solid var(--groove-line)",
			"box-shadow": "0 var(--line-width) 0 var(--groove-light)"
		},
		"@utility mark-entrance": {
			"& > [data-slot=\"four-dot-dot\"]": {
				"animation": "pluto-mark-dock calc(var(--motion-entrance) * var(--motion-entrance-dot)) both, pluto-mark-fade calc(var(--motion-entrance) * var(--motion-entrance-dot)) both",
				"animation-timing-function": "var(--ease-spring), var(--ease-entrance)"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(1)": {
				"--_ox": "-1",
				"--_oy": "0.6",
				"animation-delay": "calc(var(--motion-entrance) * (var(--motion-entrance-start) + 0 * var(--motion-entrance-stagger)))"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(2)": {
				"--_ox": "0.8",
				"--_oy": "-0.8",
				"animation-delay": "calc(var(--motion-entrance) * (var(--motion-entrance-start) + 1 * var(--motion-entrance-stagger)))"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(3)": {
				"--_ox": "-0.6",
				"--_oy": "-1",
				"animation-delay": "calc(var(--motion-entrance) * (var(--motion-entrance-start) + 2 * var(--motion-entrance-stagger)))"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(4)": {
				"--_ox": "1",
				"--_oy": "0.8",
				"animation-delay": "calc(var(--motion-entrance) * (var(--motion-entrance-start) + 3 * var(--motion-entrance-stagger)))"
			}
		},
		"@utility mark-reveal": {
			"& > [data-slot=\"four-dot-dot\"]": {
				"opacity": "0",
				"transform": "translate(calc(var(--mark-orbit) * var(--_ox)), calc(var(--mark-orbit) * var(--_oy))) scale(0.4)",
				"transition-property": "opacity, transform",
				"transition-duration": "calc(var(--motion-micro) * var(--motion-entrance-dot))",
				"transition-timing-function": "var(--ease-entrance), var(--ease-spring)"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(1)": {
				"--_ox": "-1",
				"--_oy": "0.6"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(2)": {
				"--_ox": "0.8",
				"--_oy": "-0.8"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(3)": {
				"--_ox": "-0.6",
				"--_oy": "-1"
			},
			"& > [data-slot=\"four-dot-dot\"]:nth-child(4)": {
				"--_ox": "1",
				"--_oy": "0.8"
			}
		},
		"@media (hover: hover)": {
			":hover > .mark-reveal > [data-slot=\"four-dot-dot\"]": {
				"opacity": "1",
				"transform": "none"
			},
			":hover > .mark-reveal > [data-slot=\"four-dot-dot\"]:nth-child(1)": {
				"transition-delay": "calc(var(--motion-micro) * (var(--motion-entrance-start) + 0 * var(--motion-entrance-stagger)))"
			},
			":hover > .mark-reveal > [data-slot=\"four-dot-dot\"]:nth-child(2)": {
				"transition-delay": "calc(var(--motion-micro) * (var(--motion-entrance-start) + 1 * var(--motion-entrance-stagger)))"
			},
			":hover > .mark-reveal > [data-slot=\"four-dot-dot\"]:nth-child(3)": {
				"transition-delay": "calc(var(--motion-micro) * (var(--motion-entrance-start) + 2 * var(--motion-entrance-stagger)))"
			},
			":hover > .mark-reveal > [data-slot=\"four-dot-dot\"]:nth-child(4)": {
				"transition-delay": "calc(var(--motion-micro) * (var(--motion-entrance-start) + 3 * var(--motion-entrance-stagger)))"
			}
		},
		".surface-ink": {
			"--code-background": "var(--background)",
			"--code-active-line": "var(--muted)",
			"background-color": "var(--background)",
			"color": "var(--foreground)"
		},
		".dark .surface-ink": {
			"--background": "var(--card)"
		},
		"[data-mode=\"productive\"]": {
			"--radius-action": "var(--radius)"
		},
		"[data-mode=\"expressive\"]": {
			"--radius-action": "var(--radius)"
		},
		".dark [data-mode=\"expressive\"], [data-mode=\"expressive\"].dark": {
			"--mark-1": "#93B0FF",
			"--mark-2": "#FF9491",
			"--mark-3": "#F8D874",
			"--mark-4": "#60C498"
		},
		".dark [data-mode=\"productive\"], [data-mode=\"productive\"].dark": {
			"--mark-1": "#F3F0E8",
			"--mark-2": "#F3F0E8",
			"--mark-3": "#F3F0E8",
			"--mark-4": "#F3F0E8"
		},
		"@utility rounded-action": {
			"border-radius": "var(--radius-action, var(--radius))"
		},
		"html:has([data-sticky-bar])": {
			"scroll-padding-top": "var(--size-bar)"
		},
		"@utility action-press": {
			"transition": "transform var(--motion-press) var(--ease-standard)",
			"&:active": {
				"transform": "scale(var(--press-scale))"
			}
		},
		"@utility type-display": {
			"font-family": "var(--font-face-display)",
			"font-size": "var(--type-display-size)",
			"line-height": "var(--type-display-leading)",
			"letter-spacing": "var(--type-display-tracking)",
			"font-weight": "600"
		},
		"@utility type-section": {
			"font-family": "var(--font-face-display)",
			"font-size": "var(--type-section-size)",
			"line-height": "var(--type-section-leading)",
			"letter-spacing": "var(--type-section-tracking)",
			"font-weight": "600"
		},
		"@utility type-proof": {
			"font-family": "var(--font-face-display)",
			"font-size": "var(--type-proof-size)",
			"line-height": "var(--type-proof-leading)",
			"letter-spacing": "var(--type-proof-tracking)",
			"font-weight": "600",
			"font-variant-numeric": "tabular-nums"
		},
		"@utility type-poster": {
			"font-family": "var(--font-face-display)",
			"font-size": "var(--type-poster-size)",
			"line-height": "var(--type-poster-leading)",
			"letter-spacing": "var(--type-poster-tracking)",
			"font-weight": "600"
		},
		"@utility field-1": {
			"background-color": "var(--field-1)",
			"color": "var(--field-1-foreground)",
			"--foreground": "var(--field-1-foreground)",
			"--muted-foreground": "var(--field-1-foreground)",
			"--card-foreground": "var(--field-1-foreground)",
			"--primary": "var(--field-1-foreground)",
			"--ring": "var(--field-1-foreground)",
			"--border": "color-mix(in srgb, var(--field-1-foreground) 24%, transparent)",
			"--primary-foreground": "var(--field-1)"
		},
		"@utility field-2": {
			"background-color": "var(--field-2)",
			"color": "var(--field-2-foreground)",
			"--foreground": "var(--field-2-foreground)",
			"--muted-foreground": "var(--field-2-foreground)",
			"--card-foreground": "var(--field-2-foreground)",
			"--primary": "var(--field-2-foreground)",
			"--ring": "var(--field-2-foreground)",
			"--border": "color-mix(in srgb, var(--field-2-foreground) 24%, transparent)",
			"--primary-foreground": "var(--field-2)"
		},
		"@utility field-3": {
			"background-color": "var(--field-3)",
			"color": "var(--field-3-foreground)",
			"--foreground": "var(--field-3-foreground)",
			"--muted-foreground": "var(--field-3-foreground)",
			"--card-foreground": "var(--field-3-foreground)",
			"--primary": "var(--field-3-foreground)",
			"--ring": "var(--field-3-foreground)",
			"--border": "color-mix(in srgb, var(--field-3-foreground) 24%, transparent)",
			"--primary-foreground": "var(--field-3)"
		},
		"@utility field-4": {
			"background-color": "var(--field-4)",
			"color": "var(--field-4-foreground)",
			"--foreground": "var(--field-4-foreground)",
			"--muted-foreground": "var(--field-4-foreground)",
			"--card-foreground": "var(--field-4-foreground)",
			"--primary": "var(--field-4-foreground)",
			"--ring": "var(--field-4-foreground)",
			"--border": "color-mix(in srgb, var(--field-4-foreground) 24%, transparent)",
			"--primary-foreground": "var(--field-4)"
		},
		"@utility surface-plain": {
			"--foreground": "var(--surface-foreground)",
			"--muted-foreground": "var(--surface-muted-foreground)",
			"--card-foreground": "var(--surface-card-foreground)",
			"--primary": "var(--surface-primary)",
			"--ring": "var(--surface-ring)",
			"--primary-foreground": "var(--surface-primary-foreground)",
			"--border": "var(--surface-border)"
		},
		"@utility glass": {
			"position": "relative",
			"isolation": "isolate",
			"background-color": "var(--glass-tint)",
			"-webkit-backdrop-filter": "blur(var(--glass-blur))",
			"backdrop-filter": "blur(var(--glass-blur))",
			"border": "var(--line-width) solid var(--glass-edge)",
			"border-radius": "var(--radius)",
			"box-shadow": "inset 0 1px 0 var(--glass-rim), var(--glass-shadow)",
			"--foreground": "var(--surface-foreground)",
			"--muted-foreground": "var(--surface-muted-foreground)",
			"--card-foreground": "var(--surface-card-foreground)",
			"--primary": "var(--surface-primary)",
			"--ring": "var(--surface-ring)",
			"--primary-foreground": "var(--surface-primary-foreground)",
			"--border": "var(--surface-border)",
			"color": "var(--foreground)",
			"&::after": {
				"content": "\"\"",
				"position": "absolute",
				"inset": "calc(-1 * var(--line-width))",
				"padding": "var(--line-width)",
				"border-radius": "inherit",
				"pointer-events": "none",
				"background": "radial-gradient(160px circle at var(--glass-x, 50%) var(--glass-y, 0%), var(--glass-light), transparent 70%)",
				"-webkit-mask": "linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)",
				"-webkit-mask-composite": "xor",
				"mask": "linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0)",
				"opacity": "var(--glass-lit, 0)",
				"transition": "opacity var(--motion-reveal) var(--ease-standard)"
			}
		},
		"@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))": {
			".glass": {
				"background-color": "var(--glass-fallback)",
				"-webkit-backdrop-filter": "none",
				"backdrop-filter": "none"
			}
		},
		"@media (prefers-reduced-transparency: reduce)": {
			".glass": {
				"background-color": "var(--glass-fallback)",
				"-webkit-backdrop-filter": "none",
				"backdrop-filter": "none"
			}
		},
		"@media (forced-colors: active)": {
			".glass": {
				"background-color": "var(--glass-fallback)",
				"-webkit-backdrop-filter": "none",
				"backdrop-filter": "none",
				"border-color": "CanvasText"
			}
		},
		"@utility busy-edge": {
			"transition": "box-shadow var(--motion-busy) var(--ease-standard)",
			"&[data-busy]": {
				"box-shadow": "inset 0 0 0 calc(2 * var(--line-width)) var(--primary)"
			}
		},
		"@keyframes pluto-enter": {
			"from": {
				"opacity": "0"
			}
		},
		"@keyframes pluto-exit": {
			"to": {
				"opacity": "0"
			}
		},
		"@keyframes pluto-mark-dock": {
			"from": {
				"transform": "translate(calc(var(--mark-orbit) * var(--_ox)), calc(var(--mark-orbit) * var(--_oy))) scale(0.4)"
			}
		},
		"@keyframes pluto-mark-fade": {
			"from": {
				"opacity": "0"
			}
		},
		"@layer base": {
			"body": {
				"@apply bg-background text-foreground": {}
			},
			"h1, h2, h3, h4, h5, h6": {
				"@apply font-heading": {}
			},
			":focus-visible": {
				"outline": "var(--focus-width) solid var(--ring)",
				"outline-offset": "var(--focus-offset)"
			},
			"code, kbd, samp, pre": {
				"font-variant-ligatures": "none"
			},
			"code:not(pre code, :is(h1, h2, h3, h4, h5, h6) code)": {
				"@apply rounded border border-border bg-code-background px-1 text-code-text box-decoration-clone": {}
			},
			"a code:not(pre code, :is(h1, h2, h3, h4, h5, h6) code)": {
				"@apply text-code-link": {}
			}
		},
		"@layer components": {
			"[data-slot=\"meter\"]": {
				"appearance": "none",
				"background": "var(--muted)"
			},
			"[data-slot=\"meter\"]::-webkit-meter-bar": {
				"background": "var(--muted)"
			},
			"[data-slot=\"meter\"]::-webkit-meter-optimum-value": {
				"background": "var(--primary)"
			},
			"[data-slot=\"meter\"]::-webkit-meter-suboptimum-value": {
				"background": "var(--primary)"
			},
			"[data-slot=\"meter\"]::-webkit-meter-even-less-good-value": {
				"background": "var(--primary)"
			},
			"[data-slot=\"meter\"]::-moz-meter-bar": {
				"background": "var(--primary)"
			}
		}
	},
	"cssVars": {
		"theme": {
			"radius": "0.5rem",
			"radius-xs": "var(--radius)",
			"radius-sm": "var(--radius)",
			"radius-md": "var(--radius)",
			"radius-lg": "var(--radius)",
			"radius-xl": "var(--radius)",
			"radius-2xl": "var(--radius)",
			"radius-3xl": "var(--radius)",
			"radius-4xl": "var(--radius)",
			"spacing": "0.25rem",
			"text-xs": "0.75rem",
			"text-xs--line-height": "1.5",
			"text-sm": "0.84375rem",
			"text-sm--line-height": "1.6",
			"text-base": "1rem",
			"text-base--line-height": "1.6",
			"text-2xl": "1.75rem",
			"text-2xl--line-height": "1.2",
			"text-5xl": "2.75rem",
			"text-5xl--line-height": "1.15",
			"tracking-display": "-0.03em",
			"tracking-section": "-0.02em",
			"tracking-eyebrow": "0.08em",
			"tracking-mark": "-0.04em",
			"font-weight-normal": "400",
			"font-weight-medium": "500",
			"font-weight-bold": "700",
