{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "settings",
	"title": "Settings",
	"type": "registry:block",
	"author": "Pluto Systems <https://plutosystems.co>",
	"description": "One column of sections divided by grooves, saved by one button, with an inline Saved message and a confirmed delete.",
	"registryDependencies": [
		"utils",
		"pluto-theme",
		"field",
		"input",
		"native-select",
		"checkbox",
		"radio-group",
		"button",
		"alert-dialog",
		"error-summary",
		"status"
	],
	"meta": {
		"since": "0.3.0",
		"group": "blocks"
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import SettingsDelete from \"$COMPONENTS$/settings-delete.svelte\";\n  import SettingsForm, {\n    type SettingsField,\n    type SettingsResult,\n    type SettingsValues,\n  } from \"$COMPONENTS$/settings-form.svelte\";\n  import { titleFor } from \"$UI$/error-summary\";\n\n  const values: SettingsValues = {\n    name: \"Ada Lovelace\",\n    email: \"ada@example.com\",\n    timeZone: \"Europe/London\",\n    notifyFailures: true,\n    notifySummary: false,\n    theme: \"system\",\n  };\n\n  let errors = $state<Partial<Record<SettingsField, string>>>({});\n  let formError = $state<string>();\n  const failed = $derived(\n    Object.values(errors).some(Boolean) || Boolean(formError),\n  );\n\n  // A stand-in for your server. Replace it.\n  // Your app applies the chosen theme; this block only stores the value.\n  async function saveSettings(next: SettingsValues): Promise<SettingsResult> {\n    void next;\n    await new Promise((resolve) => setTimeout(resolve, 800));\n    return { ok: true };\n  }\n\n  // A stand-in for your server. Replace it, and pass SettingsDelete your own\n  // `requested` line in place of \"Account deletion requested.\", saying what\n  // your app does next.\n  async function deleteAccount(): Promise<void> {}\n</script>\n\n<svelte:head><title>{titleFor(\"Settings\", failed)}</title></svelte:head>\n\n<div class=\"mx-auto flex max-w-2xl flex-col gap-12 px-6 py-16\">\n  <div class=\"flex flex-col gap-2\">\n    <h1\n      class=\"font-heading text-2xl font-bold tracking-section text-foreground sm:text-5xl sm:tracking-display\"\n    >\n      Settings\n    </h1>\n    <p class=\"text-muted-foreground\">Your changes apply when you save them.</p>\n  </div>\n  <SettingsForm {values} onsave={saveSettings} bind:errors bind:formError />\n  <SettingsDelete ondelete={deleteAccount} class=\"groove pt-12\" />\n</div>\n",
			"type": "registry:page",
			"target": "settings/+page.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  export type SettingsField = \"name\" | \"email\";\n  export type SettingsValues = {\n    name: string;\n    email: string;\n    timeZone: string;\n    notifyFailures: boolean;\n    notifySummary: boolean;\n    theme: \"system\" | \"light\" | \"dark\";\n  };\n  export type SettingsResult =\n    | { ok: true }\n    | {\n        ok: false;\n        errors?: Partial<Record<SettingsField, string>>;\n        formError?: string;\n      };\n\n  /** The house wording, for the states the app's server reports too. */\n  export const MESSAGES = {\n    /** When the callback throws or rejects. */\n    failed: \"We could not save your changes. Try again.\",\n    nameEmpty: \"Enter your name\",\n    emailEmpty: \"Enter your email address\",\n    emailFormat: \"Enter an email address like name@example.com\",\n  } as const;\n\n  /** A short list of IANA zones; an app passes its own. */\n  export const TIME_ZONES = [\n    { value: \"Etc/UTC\", label: \"Coordinated Universal Time\" },\n    { value: \"Europe/London\", label: \"London\" },\n    { value: \"America/New_York\", label: \"New York\" },\n    { value: \"Asia/Tokyo\", label: \"Tokyo\" },\n  ];\n\n  function same(a: SettingsValues, b: SettingsValues): boolean {\n    return (Object.keys(a) as (keyof SettingsValues)[]).every(\n      (key) => a[key] === b[key],\n    );\n  }\n</script>\n\n<script lang=\"ts\">\n  import { tick } from \"svelte\";\n  import { Button } from \"$UI$/button\";\n  import { Checkbox } from \"$UI$/checkbox\";\n  import { ErrorSummary } from \"$UI$/error-summary\";\n  import * as Field from \"$UI$/field\";\n  import { Input } from \"$UI$/input\";\n  import * as NativeSelect from \"$UI$/native-select\";\n  import * as RadioGroup from \"$UI$/radio-group\";\n  import { Status } from \"$UI$/status\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    values,\n    draft,\n    onsave,\n    errors = $bindable({}),\n    formError = $bindable(),\n    busy = $bindable(false),\n    saved = $bindable(false),\n    dirty = $bindable(false),\n    timeZones = TIME_ZONES,\n    idPrefix = \"settings\",\n    class: className,\n  }: {\n    /** What is saved when the form mounts. */\n    values: SettingsValues;\n    /** The fields' starting values; default `values`. */\n    draft?: SettingsValues;\n    onsave: (values: SettingsValues) => Promise<SettingsResult>;\n    errors?: Partial<Record<SettingsField, string>>;\n    formError?: string;\n    busy?: boolean;\n    /** Shows \"Saved\". */\n    saved?: boolean;\n    /** Read-only to the app: the fields differ from the saved copy. */\n    dirty?: boolean;\n    timeZones?: { value: string; label: string }[];\n    idPrefix?: string;\n    class?: string;\n  } = $props();\n\n  // The saved copy is the form's own: `values` is read once, at mount, and\n  // replaced here after each save.\n  // svelte-ignore state_referenced_locally\n  let savedCopy = $state<SettingsValues>({ ...values });\n  // svelte-ignore state_referenced_locally\n  let form = $state<SettingsValues>({ ...(draft ?? values) });\n  let announce = $state(false);\n  let notice = $state(\"\");\n  let summary = $state<HTMLElement | null>(null);\n  let nameInput = $state<HTMLInputElement | null>(null);\n\n  const changed = $derived(!same(form, savedCopy));\n  const ids = $derived({\n    name: `${idPrefix}-name`,\n    email: `${idPrefix}-email`,\n    timeZone: `${idPrefix}-time-zone`,\n    failures: `${idPrefix}-notify-failures`,\n    summary: `${idPrefix}-notify-summary`,\n    theme: `${idPrefix}-theme`,\n  });\n  const links = $derived(\n    ([\"name\", \"email\"] as const)\n      .filter((field) => errors[field])\n      .map((field) => ({ id: ids[field], message: errors[field]! })),\n  );\n  const statusText = $derived(busy ? \"Saving…\" : saved ? \"Saved\" : notice);\n\n  $effect(() => {\n    dirty = changed;\n  });\n  // The first change after a save or a discard clears what the status said.\n  $effect(() => {\n    if (changed) {\n      saved = false;\n      notice = \"\";\n    }\n  });\n\n  function validate(): Partial<Record<SettingsField, string>> {\n    const email = form.email.trim();\n    return {\n      name: form.name.trim() ? undefined : MESSAGES.nameEmpty,\n      email: !email\n        ? MESSAGES.emailEmpty\n        : /^[^@\\s]+@[^@\\s]+$/.test(email)\n          ? undefined\n          : MESSAGES.emailFormat,\n    };\n  }\n\n  async function failed() {\n    announce = true;\n    await tick();\n    summary?.focus();\n  }\n\n  async function submit(event: SubmitEvent) {\n    event.preventDefault();\n    if (busy) return;\n    const found = validate();\n    if (found.name || found.email) {\n      notice = \"\";\n      errors = found;\n      formError = undefined;\n      return failed();\n    }\n    errors = {};\n    formError = undefined;\n    notice = \"\";\n    saved = false;\n    const next = $state.snapshot(form);\n    busy = true;\n    let result: SettingsResult;\n    try {\n      result = await onsave(next);\n    } catch {\n      // A callback that throws keeps every change and says so.\n      busy = false;\n      formError = MESSAGES.failed;\n      notice = MESSAGES.failed;\n      return failed();\n    } finally {\n      busy = false;\n    }\n    if (result.ok) {\n      savedCopy = next;\n      saved = true;\n      return;\n    }\n    errors = result.errors ?? {};\n    formError = result.formError;\n    return failed();\n  }\n\n  // Discarding unmounts the focused button, so focus moves to the first\n  // field, and the status says what happened.\n  async function discard() {\n    form = { ...savedCopy };\n    errors = {};\n    formError = undefined;\n    await tick();\n    notice = \"Changes discarded.\";\n    nameInput?.focus();\n  }\n\n  function beforeUnload(event: BeforeUnloadEvent) {\n    if (!changed) return;\n    event.preventDefault();\n    event.returnValue = \"\";\n  }\n\n  // A legend's h2 ranks under the page's h1 at every width.\n  const legend = \"font-heading text-base font-bold\";\n  const set = \"*:data-[slot=field-description]:order-first\";\n</script>\n\n<svelte:window onbeforeunload={beforeUnload} />\n\n<!--\n  One column of sections, saved by one button at the bottom. Nothing here\n  saves at once, so the form has no switches.\n-->\n<form\n  novalidate\n  data-slot=\"settings-form\"\n  class={cn(\"flex flex-col gap-12\", className)}\n  onsubmit={submit}\n>\n  <ErrorSummary\n    bind:ref={summary}\n    {announce}\n    errors={links}\n    message={formError}\n  />\n\n  <Field.Set description=\"How you appear to people you work with.\" class={set}>\n    <Field.Legend><h2 class={legend}>Profile</h2></Field.Legend>\n    <Field.Field id={ids.name} error={errors.name}>\n      <Field.Label>Name</Field.Label>\n      <Input bind:ref={nameInput} autocomplete=\"name\" bind:value={form.name} />\n    </Field.Field>\n    <Field.Field\n      id={ids.email}\n      error={errors.email}\n      description=\"Notices about your account go here.\"\n    >\n      <Field.Label>Email address</Field.Label>\n      <Input\n        type=\"email\"\n        autocomplete=\"email\"\n        spellcheck={false}\n        autocapitalize=\"off\"\n        bind:value={form.email}\n      />\n    </Field.Field>\n    <Field.Field\n      id={ids.timeZone}\n      description=\"Dates and times show in this zone.\"\n    >\n      <Field.Label>Time zone</Field.Label>\n      <NativeSelect.Root bind:value={form.timeZone}>\n        {#each timeZones as zone (zone.value)}\n          <NativeSelect.Option value={zone.value}\n            >{zone.label}</NativeSelect.Option\n          >\n        {/each}\n      </NativeSelect.Root>\n    </Field.Field>\n  </Field.Set>\n\n  <div class=\"groove pt-12\">\n    <Field.Set description=\"Choose what we email you about.\" class={set}>\n      <Field.Legend><h2 class={legend}>Email notifications</h2></Field.Legend>\n      <Field.Field id={ids.failures} orientation=\"horizontal\">\n        <Checkbox bind:checked={form.notifyFailures} />\n        <Field.Label>When a run fails</Field.Label>\n      </Field.Field>\n      <Field.Field id={ids.summary} orientation=\"horizontal\">\n        <Checkbox bind:checked={form.notifySummary} />\n        <Field.Label>A weekly summary</Field.Label>\n      </Field.Field>\n    </Field.Set>\n  </div>\n\n  <div class=\"groove pt-12\">\n    <Field.Set description=\"The colour scheme for this device.\" class={set}>\n      <Field.Legend><h2 class={legend}>Theme</h2></Field.Legend>\n      <RadioGroup.Root bind:value={form.theme}>\n        {#each [[\"system\", \"Match the system\"], [\"light\", \"Light\"], [\"dark\", \"Dark\"]] as [value, label] (value)}\n          <Field.Field orientation=\"horizontal\">\n            <RadioGroup.Item {value} id=\"{ids.theme}-{value}\" />\n            <Field.Label for=\"{ids.theme}-{value}\">{label}</Field.Label>\n          </Field.Field>\n        {/each}\n      </RadioGroup.Root>\n    </Field.Set>\n  </div>\n\n  <div class=\"flex flex-col gap-3 sm:flex-row sm:items-center\">\n    <Button type=\"submit\" {busy} class=\"w-full sm:w-auto\">Save changes</Button>\n    {#if changed}\n      <Button variant=\"secondary\" class=\"w-full sm:w-auto\" onclick={discard}\n        >Discard changes</Button\n      >\n    {/if}\n    <Status\n      visible\n      text={statusText}\n      class={cn(\"text-sm\", statusText === \"Saved\" && \"text-success\")}\n    />\n  </div>\n</form>\n",
			"type": "registry:component",
			"target": "settings-form.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { tick } from \"svelte\";\n  import * as AlertDialog from \"$UI$/alert-dialog\";\n  import { buttonVariants } from \"$UI$/button\";\n  import { ErrorSummary } from \"$UI$/error-summary\";\n  import { Status } from \"$UI$/status\";\n  import { cn } from \"$UTILS$\";\n\n  /** When the callback throws or rejects. */\n  const FAILED = \"We could not delete your account. Try again.\";\n\n  let {\n    ondelete,\n    level = 2,\n    requested = \"Account deletion requested.\",\n    class: className,\n  }: {\n    ondelete: () => Promise<void>;\n    level?: 1 | 2 | 3 | 4 | 5 | 6;\n    /** What the status says once `ondelete` resolves. Say what your app did. */\n    requested?: string;\n    class?: string;\n  } = $props();\n\n  let open = $state(false);\n  let text = $state(\"\");\n  let message = $state<string>();\n  let summary = $state<HTMLElement | null>(null);\n  // The summary's title ranks under this section's heading.\n  const summaryLevel = $derived(Math.min(level + 1, 6) as 2 | 3 | 4 | 5 | 6);\n\n  async function confirm() {\n    open = false;\n    message = undefined;\n    text = \"\";\n    try {\n      await ondelete();\n      text = requested;\n    } catch {\n      message = FAILED;\n      text = FAILED;\n      await tick();\n      summary?.focus();\n    }\n  }\n</script>\n\n<!--\n  The destructive section, outside the settings form: it is not a setting\n  that Save changes saves. The trigger spends no red; the dialog's confirm\n  does, and the dialog starts on the safe choice.\n-->\n<section\n  data-slot=\"settings-delete\"\n  class={cn(\"flex flex-col gap-6\", className)}\n>\n  <div class=\"flex flex-col gap-2\">\n    <svelte:element\n      this={`h${level}`}\n      class=\"font-heading text-base font-bold text-foreground\"\n    >\n      Delete your account\n    </svelte:element>\n    <p class=\"max-w-prose text-muted-foreground\">\n      This removes your projects, runs and settings for good. It cannot be\n      undone.\n    </p>\n  </div>\n  <ErrorSummary bind:ref={summary} {message} level={summaryLevel} />\n  <div class=\"flex flex-col gap-3 sm:flex-row sm:items-center\">\n    <AlertDialog.Root bind:open>\n      <AlertDialog.Trigger\n        class={cn(buttonVariants({ variant: \"secondary\" }), \"w-full sm:w-auto\")}\n        >Delete account</AlertDialog.Trigger\n      >\n      <AlertDialog.Content>\n        <AlertDialog.Header>\n          <AlertDialog.Title>Delete your account?</AlertDialog.Title>\n          <AlertDialog.Description>\n            Your projects, runs and settings will be removed for good. You\n            cannot undo this.\n          </AlertDialog.Description>\n        </AlertDialog.Header>\n        <AlertDialog.Footer>\n          <AlertDialog.Cancel>Keep my account</AlertDialog.Cancel>\n          <AlertDialog.Action variant=\"destructive\" onclick={confirm}\n            >Delete account</AlertDialog.Action\n          >\n        </AlertDialog.Footer>\n      </AlertDialog.Content>\n    </AlertDialog.Root>\n    <Status visible {text} class=\"text-sm\" />\n  </div>\n</section>\n",
			"type": "registry:component",
			"target": "settings-delete.svelte"
		}
	]
}