	"files": [
		{
			"content": "<script lang=\"ts\" module>\n  import { tv, type VariantProps } from \"tailwind-variants/lite\";\n\n  /**\n   * A line in a conversation that is not a turn. `separator` draws the\n   * hairline either side (R22: a border, not a 1 px box); `border` underlines\n   * it. No role by default: a marker inserted with its text is the silent\n   * live-region case, the log announces it as an added node, and the state is\n   * told by the status item. An app passes a role when it means one.\n   */\n  export const markerVariants = tv({\n    base: \"group/marker relative flex min-h-4 w-full items-center gap-2 text-start text-sm text-muted-foreground [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-foreground [&_svg:not([class*='size-'])]:size-4\",\n    variants: {\n      variant: {\n        default: \"\",\n        separator:\n          \"before:min-w-0 before:flex-1 before:border-t before:border-border after:min-w-0 after:flex-1 after:border-t after:border-border\",\n        border: \"border-b border-border pb-2\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n    },\n  });\n\n  export type MarkerVariant = VariantProps<typeof markerVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    variant = \"default\",\n    child,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n    variant?: MarkerVariant;\n    child?: Snippet<[{ props: Record<string, unknown> }]>;\n  } = $props();\n\n  const mergedProps = $derived({\n    class: cn(markerVariants({ variant }), className),\n    \"data-slot\": \"marker\",\n    \"data-variant\": variant,\n    ...restProps,\n  });\n</script>\n\n{#if child}\n  {@render child({ props: mergedProps })}\n{:else}\n  <div bind:this={ref} {...mergedProps}>\n    {@render mergedProps.children?.()}\n  </div>\n{/if}\n",
			"type": "registry:ui",
			"target": "marker/marker.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLSpanElement>> = $props();\n</script>\n\n<!-- Decoration beside the text, hidden from assistive technology. -->\n<span\n  bind:this={ref}\n  data-slot=\"marker-icon\"\n  aria-hidden=\"true\"\n  class={cn(\"size-4 shrink-0 [&_svg:not([class*='size-'])]:size-4\", className)}\n  {...restProps}\n>\n  {@render children?.()}\n</span>\n",
			"type": "registry:ui",
			"target": "marker/marker-icon.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLSpanElement>> = $props();\n</script>\n\n<span\n  bind:this={ref}\n  data-slot=\"marker-content\"\n  class={cn(\n    \"min-w-0 wrap-break-word group-data-[variant=separator]/marker:flex-none group-data-[variant=separator]/marker:text-center\",\n    className,\n  )}\n  {...restProps}\n>\n  {@render children?.()}\n</span>\n",
			"type": "registry:ui",
			"target": "marker/marker-content.svelte"
		},
		{
			"content": "import Content from \"./marker-content.svelte\";\nimport Icon from \"./marker-icon.svelte\";\nimport Root, { markerVariants, type MarkerVariant } from \"./marker.svelte\";\n\nexport {\n  Root,\n  Icon,\n  Content,\n  markerVariants,\n  type MarkerVariant,\n  //\n  Root as Marker,\n  Icon as MarkerIcon,\n  Content as MarkerContent,\n};\n",
			"type": "registry:ui",
			"target": "marker/index.ts"
		}
	]
