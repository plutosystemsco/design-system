{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "tag",
	"title": "Tag",
	"type": "registry:ui",
	"author": "Pluto Systems <https://github.com/plutosystemsco/design-system>",
	"description": "A short label you can remove or press, in a named list that moves focus to its neighbour when a tag is removed.",
	"devDependencies": [
		"phosphor-svelte@^3.1.1"
	],
	"registryDependencies": [
		"utils",
		"kuiper-theme",
		"button"
	],
	"meta": {
		"since": "0.13.0",
		"group": "actions",
		"modes": [
			"productive"
		]
	},
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  export type TagGroupProps = Omit<\n    HTMLAttributes<HTMLUListElement>,\n    \"class\" | \"children\"\n  > & {\n    /** What the tags are, such as \"Filters\". Or use `aria-labelledby`. Required: a list of tags needs a name. */\n    \"aria-label\"?: string;\n    /** Where focus goes when no tag control is left, such as the input that adds tags. Without it, the list itself takes focus, and its name is spoken. */\n    fallback?: () => HTMLElement | null;\n    /** Classes for the list. */\n    class?: string;\n    /** The list, bound. */\n    ref?: HTMLUListElement | null;\n    /** The tags: `Tag`s, each an item of the list. */\n    children?: Snippet;\n  };\n\n  /** What a `Tag` tells its group, under the key \"kuiper:tag-group\". */\n  export type TagGroupContext = {\n    /** Called by a tag before its `onremove`: its control's index among the group's tag controls. */\n    removing(index: number): void;\n  };\n\n  /** The context key a `TagGroup` sets and a `Tag` reads. */\n  export const TAG_GROUP_KEY = \"kuiper:tag-group\";\n</script>\n\n<script lang=\"ts\">\n  import { setContext, tick } from \"svelte\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    fallback,\n    children,\n    ...restProps\n  }: TagGroupProps = $props();\n\n  // One index space: the group's tag controls, remove buttons and\n  // pressable tags, in DOM order. Static tags hold none. After the app\n  // removes the tag, focus goes to the control now at its index, then the\n  // one before, then the fallback, then the list.\n  setContext<TagGroupContext>(TAG_GROUP_KEY, {\n    removing(index) {\n      void tick().then(() => {\n        const list = ref;\n        if (!list) return;\n        const controls =\n          list.querySelectorAll<HTMLElement>(\"[data-tag-control]\");\n        const next =\n          controls[index] ?? controls[index - 1] ?? fallback?.() ?? list;\n        next.focus();\n      });\n    },\n  });\n</script>\n\n<!--\n  A named list of tags that keeps focus when a tag goes. The explicit list\n  role keeps its semantics in WebKit, which drops them from an unstyled\n  list outside a nav. It takes focus, by script only, when it empties.\n-->\n<!-- svelte-ignore a11y_no_redundant_roles -->\n<ul\n  bind:this={ref}\n  data-slot=\"tag-group\"\n  role=\"list\"\n  tabindex=\"-1\"\n  class={cn(\"flex flex-wrap items-center gap-2\", className)}\n  {...restProps}\n>\n  {@render children?.()}\n</ul>\n",
			"type": "registry:ui",
			"target": "tag/tag-group.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  /** Every word a tag says, for an app to translate. */\n  export type TagStrings = {\n    /** The remove button's name, from the tag's label: \"Remove Design\". */\n    remove: (label: string) => string;\n  };\n\n  const STRINGS: TagStrings = { remove: (label) => `Remove ${label}` };\n\n  type TagBase = Omit<HTMLAttributes<HTMLElement>, \"class\" | \"children\"> & {\n    /** The tag's text: three words or fewer. It also names the remove button. */\n    label: string;\n    /** Makes the tag removable. Called when its remove button is pressed, or when Delete or Backspace is pressed on it. Remove the tag from your list in this call; the group moves focus. Not with `pressed`. */\n    onremove?: () => void;\n    /** Makes the tag pressable: a toggle button, `aria-pressed`, with a check while pressed. Not with `onremove`. */\n    pressed?: boolean;\n    /** Called after a pressable tag is pressed, with its new state. */\n    onpressedchange?: (pressed: boolean) => void;\n    /** A leading icon. It is hidden from assistive technology; the label says what the tag is. */\n    icon?: Snippet;\n    /** `remove`, `(label) => \"Remove \" + label`: the remove button's name. */\n    strings?: Partial<TagStrings>;\n    /** Classes for the tag. */\n    class?: string;\n  };\n\n  /** A tag is removable, pressable or static: never removable and pressable at once. */\n  type TagKind =\n    | { onremove: () => void; pressed?: never; onpressedchange?: never }\n    | { pressed: boolean; onremove?: never }\n    | { onremove?: never; pressed?: never; onpressedchange?: never };\n\n  export type TagProps = TagBase & TagKind;\n\n  // A tag's shape: a solid input-coloured border, never the translucent\n  // hairline, and the font's own spacing.\n  const LOOK =\n    \"inline-flex h-8 items-center gap-1 rounded border border-input bg-card px-2 text-sm whitespace-nowrap text-foreground\";\n  const PRESSABLE =\n    \"cursor-pointer transition-[color,background-color,border-color] select-none hover:not-aria-pressed:bg-accent hover:not-aria-pressed:text-accent-foreground aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground\";\n</script>\n\n<script lang=\"ts\">\n  import Check from \"phosphor-svelte/lib/Check\";\n  import Plus from \"phosphor-svelte/lib/Plus\";\n  import X from \"phosphor-svelte/lib/X\";\n  import { getContext } from \"svelte\";\n  import { Button } from \"$UI$/button\";\n  import { cn } from \"$UTILS$\";\n  import { TAG_GROUP_KEY, type TagGroupContext } from \"./tag-group.svelte\";\n\n  let {\n    label,\n    onremove,\n    pressed = $bindable(),\n    onpressedchange,\n    icon,\n    strings,\n    class: className,\n    ...restProps\n  }: TagProps = $props();\n\n  const group = getContext<TagGroupContext | undefined>(TAG_GROUP_KEY);\n  const s = $derived({ ...STRINGS, ...strings });\n  const kind = $derived(\n    onremove ? \"removable\" : pressed !== undefined ? \"pressable\" : \"static\",\n  );\n  let control: HTMLElement | null = $state(null);\n\n  /** Tells the group the control's index, then lets the app remove the tag. */\n  function remove() {\n    const list = control?.closest('[data-slot=\"tag-group\"]');\n    if (control && list)\n      group?.removing(\n        Array.from(list.querySelectorAll(\"[data-tag-control]\")).indexOf(\n          control,\n        ),\n      );\n    onremove?.();\n  }\n\n  function onRemoveKey(event: KeyboardEvent) {\n    if (event.key !== \"Delete\" && event.key !== \"Backspace\") return;\n    event.preventDefault();\n    remove();\n  }\n\n  function toggle() {\n    pressed = !pressed;\n    onpressedchange?.(pressed);\n  }\n</script>\n\n{#snippet leading()}\n  {#if icon}\n    <span\n      data-slot=\"tag-icon\"\n      aria-hidden=\"true\"\n      class=\"flex [&_svg]:size-4 [&_svg]:shrink-0\"\n    >\n      {@render icon()}\n    </span>\n  {/if}\n{/snippet}\n\n<!--\n  A short label to remove or press. A removable tag holds a remove button\n  named for it; Delete and Backspace remove it too, and its group moves\n  focus; its focus indicator stays inside the tag, at no offset. A pressable tag is a toggle button,\n  a plus that turns to a check while pressed, at one width. Other\n  attributes go on the tag's li (or span), not on its button. A\n  static tag is text in a tag's shape.\n-->\n<svelte:element\n  this={group ? \"li\" : \"span\"}\n  data-slot=\"tag\"\n  data-kind={kind}\n  class={cn(\n    kind === \"pressable\" ? \"inline-flex\" : LOOK,\n    kind === \"removable\" && \"pe-1\",\n    className,\n  )}\n  {...restProps}\n>\n  {#if kind === \"pressable\"}\n    <button\n      bind:this={control}\n      type=\"button\"\n      data-slot=\"tag-toggle\"\n      data-tag-control=\"\"\n      aria-pressed={pressed ? \"true\" : \"false\"}\n      class={cn(LOOK, PRESSABLE)}\n      onclick={toggle}\n    >\n      {@render leading()}\n      <span data-slot=\"tag-label\">{label}</span>\n      <!-- One icon in one place: a plus to add, a check while pressed, so\n           pressing never changes the tag's width. -->\n      {#if pressed}\n        <Check data-slot=\"tag-check\" aria-hidden=\"true\" class=\"size-4\" />\n      {:else}\n        <Plus data-slot=\"tag-add\" aria-hidden=\"true\" class=\"size-4\" />\n      {/if}\n    </button>\n  {:else}\n    {@render leading()}\n    <span data-slot=\"tag-label\">{label}</span>\n    {#if kind === \"removable\"}\n      <Button\n        bind:ref={control}\n        data-slot=\"tag-remove\"\n        data-tag-control=\"\"\n        variant=\"ghost\"\n        size=\"icon-sm\"\n        class=\"size-6 [--focus-offset:0]\"\n        aria-label={s.remove(label)}\n        onclick={remove}\n        onkeydown={onRemoveKey}\n      >\n        <X aria-hidden=\"true\" />\n      </Button>\n    {/if}\n  {/if}\n</svelte:element>\n",
			"type": "registry:ui",
			"target": "tag/tag.svelte"
		},
		{
			"content": "import Group, { type TagGroupProps } from \"./tag-group.svelte\";\nimport Root, { type TagProps, type TagStrings } from \"./tag.svelte\";\n\nexport {\n  Root,\n  Group,\n  type TagProps as Props,\n  //\n  Group as TagGroup,\n  Root as Tag,\n  type TagGroupProps,\n  type TagProps,\n  type TagStrings,\n};\n",
			"type": "registry:ui",
			"target": "tag/index.ts"
		}
	]
}