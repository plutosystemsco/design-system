      "$type": "color",
      "$value": "{primitive.graphite}",
      "$description": "The page's ground.",
      "$extensions": {
        "co.plutosystems.kuiper": {
          "cssVariable": "--background",
          "since": "0.1.0"
        }
      }
    },
    "foreground": {
      "$type": "color",
      "$value": "{primitive.paper}",
      "$description": "Text and icons on the page's ground.",
      "$extensions": {
        "co.plutosystems.kuiper": {
          "cssVariable": "--foreground",
          "since": "0.1.0"
        }
      }
    },
    "card": {
      "$type": "color",
      "$value": "{primitive.ink-raised}",
      "$description": "A card's surface, one step up from the ground.",
      "$extensions": {
        "co.plutosystems.kuiper": { "cssVariable": "--card", "since": "0.1.0" }
      }
