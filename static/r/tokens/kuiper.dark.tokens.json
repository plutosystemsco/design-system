      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0784, 0.0588],
        "alpha": 0.8392,
        "hex": "#16140F"
      },
      "$description": "The frosted tint over what lies behind.",
      "$extensions": {
        "co.plutosystems.kuiper": {
          "cssVariable": "--glass-tint",
          "since": "0.11.0"
        }
      }
