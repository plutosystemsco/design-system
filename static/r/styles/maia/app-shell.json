{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "app-shell",
	"title": "App shell",
	"type": "registry:block",
	"author": "Pluto Systems <https://plutosystems.co>",
	"description": "The frame every page sits in: a skip link, a header with the lockup's one entrance and a theme toggle, an optional sidebar, the main area, and a footer that states the build.",
