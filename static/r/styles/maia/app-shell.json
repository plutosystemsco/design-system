		"utils",
		"pluto-theme",
		"four-dot",
		"theme",
		"button",
		"sheet",
		"sidebar",
		"breadcrumb",
		"dropdown-menu",
		"avatar",
		"collapsible"
	],
	"meta": {
		"since": "0.6.0",
		"group": "blocks"
	},
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import { version } from \"$app/env\";\n  import { page } from \"$app/state\";\n  import AppShellFooter from \"$COMPONENTS$/app-shell-footer.svelte\";\n  import AppShellHeader from \"$COMPONENTS$/app-shell-header.svelte\";\n  import AppShellSidebar from \"$COMPONENTS$/app-shell-sidebar.svelte\";\n  import AppShellSkipLink from \"$COMPONENTS$/app-shell-skip-link.svelte\";\n  import * as Breadcrumb from \"$UI$/breadcrumb\";\n  import * as Sidebar from \"$UI$/sidebar\";\n  import { ThemeScript } from \"$UI$/theme\";\n\n  // Your app's values. Move this file and +layout.server.ts to src/routes/,\n  // and first replace LINKS and the sidebar's hrefs with your own routes: an\n  // anchor such as #overview in a root layout fails the prerender of every\n  // page that has no such id.\n  const APP_NAME = \"Pluto app\";\n  const LINKS = [\n    { label: \"Overview\", href: \"#overview\" },\n    { label: \"Activity\", href: \"#activity\" },\n    { label: \"Members\", href: \"#members\" },\n  ];\n  /** false, \"offcanvas\" or \"icon\". With a sidebar, the navigation and the account live in it. */\n  const SIDEBAR: false | \"offcanvas\" | \"icon\" = false;\n  /** Without a sidebar only; then add `html { scroll-padding-top: 4rem }` to your app.css. */\n  const STICKY = false;\n  const USER: { name: string; email: string } | null = null;\n  const FOOTER = {\n    // SvelteKit's version name: the commit when vite.config.ts sets it (the\n    // item page shows the lines); its default is a timestamp, all digits,\n    // which means no commit: no row.\n    commit: /^\\d+$/.test(version) ? undefined : version,\n    // The commit's own date, set by vite.config.ts; without it, no row.\n    builtAt: import.meta.env.VITE_BUILT_AT as string | undefined,\n    // Your doc ID, `PS-<series>-<NNNN>`; without it, no row.\n    docId: undefined,\n    // Your app's repository. Shipped as the design system's.\n    sourceHref: \"https://github.com/plutosystemsco/design-system\",\n    // One plain sentence, only when it is true.\n    statement: undefined,\n  };\n\n  let {\n    data,\n    children,\n  }: { data: { sidebarOpen: boolean }; children: Snippet } = $props();\n\n  // The current page, for aria-current: the shipped links are anchors.\n  const current = $derived(page.url.hash);\n</script>\n\n<!-- The theme's head script, once, so the theme is right before paint on every page. -->\n<ThemeScript />\n\n{#snippet shell()}\n  <AppShellSkipLink />\n  <AppShellHeader\n    appName={APP_NAME}\n    links={LINKS}\n    {current}\n    sidebar={Boolean(SIDEBAR)}\n    user={USER}\n    sticky={STICKY}\n  />\n  {#if SIDEBAR}\n    <div class=\"flex flex-1\">\n      <AppShellSidebar\n        links={LINKS}\n        {current}\n        user={USER}\n        collapsible={SIDEBAR}\n      />\n      <Sidebar.Inset>\n        <div class=\"flex h-16 items-center px-6\">\n          <Breadcrumb.Root>\n            <Breadcrumb.List>\n              <Breadcrumb.Item>\n                <Breadcrumb.Link href=\"/\">Home</Breadcrumb.Link>\n              </Breadcrumb.Item>\n              <Breadcrumb.Separator />\n              <Breadcrumb.Item>\n                <Breadcrumb.Page>Projects</Breadcrumb.Page>\n              </Breadcrumb.Item>\n            </Breadcrumb.List>\n          </Breadcrumb.Root>\n        </div>\n        <div class=\"flex-1 px-6 pb-12\">\n          {@render children()}\n        </div>\n      </Sidebar.Inset>\n    </div>\n  {:else}\n    <main\n      id=\"main\"\n      tabindex=\"-1\"\n      class=\"mx-auto w-full max-w-5xl flex-1 px-6 py-12\"\n    >\n      {@render children()}\n    </main>\n  {/if}\n  <AppShellFooter {...FOOTER} />\n{/snippet}\n\n<!--\n  The frame every page sits in: the skip link first in body, the header,\n  the main area (or the row of sidebar and inset), the footer. With a\n  sidebar the provider is the root column, so the header's trigger reads its\n  context; the row of sidebar and inset is this layout's own div.\n-->\n{#if SIDEBAR}\n  <Sidebar.Provider open={data.sidebarOpen}>\n    {@render shell()}\n  </Sidebar.Provider>\n{:else}\n  <div class=\"flex min-h-svh flex-col\">\n    {@render shell()}\n  </div>\n{/if}\n",
			"type": "registry:page",
			"target": "app-shell/+layout.svelte"
		},
		{
			"content": "import type { ServerLoadEvent } from \"@sveltejs/kit\";\n\n/**\n * Reads the sidebar's cookie, which the provider writes on every toggle and\n * never reads (005 decision 10), so the first paint is right. Under\n * prerender there is no cookie and the sidebar opens.\n */\nexport const load = ({ cookies }: ServerLoadEvent) => ({\n  sidebarOpen: cookies.get(\"sidebar_state\") !== \"false\",\n});\n",
			"type": "registry:page",
			"target": "app-shell/+layout.server.ts"
		},
		{
			"content": "<script lang=\"ts\">\n  import { Button } from \"$UI$/button\";\n\n  // The example page the shell wraps: one h1, and the three sections the\n  // shipped links point at. Replace it with your own routes.\n  const sections = [\n    {\n      id: \"overview\",\n      title: \"Overview\",\n      text: \"Three projects are active this week.\",\n      link: { label: \"Open the catalogue\", href: \"/\" },\n    },\n    {\n      id: \"activity\",\n      title: \"Activity\",\n      text: \"Nothing has changed since Friday.\",\n    },\n    { id: \"members\", title: \"Members\", text: \"Four people have access.\" },\n  ];\n</script>\n\n<svelte:head><title>Projects</title></svelte:head>\n\n<div class=\"flex flex-col gap-12\">\n  <h1\n    class=\"font-heading text-2xl font-bold tracking-section sm:text-5xl sm:tracking-display\"\n  >\n    Projects\n  </h1>\n  {#each sections as section (section.id)}\n    <section id={section.id} class=\"groove flex flex-col gap-2 pt-12\">\n      <h2 class=\"font-heading text-base font-bold\">{section.title}</h2>\n      <p class=\"max-w-prose text-muted-foreground\">{section.text}</p>\n      {#if section.link}\n        <Button variant=\"link\" href={section.link.href} class=\"self-start\">\n          {section.link.label}\n        </Button>\n      {/if}\n    </section>\n  {/each}\n</div>\n",
			"type": "registry:page",
			"target": "app-shell/+page.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn } from \"$UTILS$\";\n  import type { HTMLAnchorAttributes } from \"svelte/elements\";\n\n  let {\n    href = \"#main\",\n    class: className,\n    ...restProps\n  }: HTMLAnchorAttributes = $props();\n</script>\n\n<!--\n  First in <body>, before the header: hidden until it has focus, then a box\n  at the top start corner above everything, with the global ring. `sr-only`,\n  not `hidden`: display none would leave the tab order. Enter lands focus on\n  the shell's <main id=\"main\" tabindex=\"-1\">.\n-->\n<a\n  data-slot=\"app-shell-skip-link\"\n  {href}\n  class={cn(\n    \"sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-50 focus:rounded focus:bg-card focus:px-4 focus:py-2 focus:text-sm\",\n    className,\n  )}\n  {...restProps}\n>\n  Skip to main content\n</a>\n",
			"type": "registry:component",
			"target": "app-shell-skip-link.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import List from \"phosphor-svelte/lib/List\";\n  import { afterNavigate } from \"$app/navigation\";\n  import AppShellNav, {\n    type AppShellLink,\n  } from \"$COMPONENTS$/app-shell-nav.svelte\";\n  import AppShellUserMenu, {\n    type AppShellUser,\n  } from \"$COMPONENTS$/app-shell-user-menu.svelte\";\n  import { Button } from \"$UI$/button\";\n  import { Lockup } from \"$UI$/four-dot\";\n  import * as Sheet from \"$UI$/sheet\";\n  import { SidebarTrigger } from \"$UI$/sidebar\";\n  import { ThemeToggle } from \"$UI$/theme\";\n  import { cn } from \"$UTILS$\";\n\n  let {\n    appName,\n    links = [],\n    current,\n    sidebar = false,\n    user = null,\n    sticky = false,\n    settingsHref = \"/\",\n    signOutHref = \"/\",\n    class: className,\n  }: {\n    /** The app's name: the lockup's accessible name and the nav sheet's title. */\n    appName: string;\n    links?: AppShellLink[];\n    /** The current page's href, from `page.url`. */\n    current?: string;\n    /** With a sidebar the header holds its trigger and nothing else of the navigation: the links and the account live in the sidebar. */\n    sidebar?: boolean;\n    user?: AppShellUser | null;\n    /** Without a sidebar: sticks to the top, under every overlay; the app then sets `scroll-padding-top` in its CSS. With a sidebar the header is always sticky. */\n    sticky?: boolean;\n    settingsHref?: string;\n    signOutHref?: string;\n    class?: string;\n  } = $props();\n\n  // The phone's nav sheet closes when a link in it navigates: the shell's\n  // layout survives a client-side navigation, so an open sheet would too.\n  let menuOpen = $state(false);\n  afterNavigate(() => {\n    menuOpen = false;\n  });\n</script>\n\n<!--\n  The banner: a 64 px row (a 48 px control and 8 px either side) on the\n  background, grooved on its bottom edge. The lockup at 28 px is the home\n  link and plays the page's one entrance. Without a sidebar the primary nav\n  shows from md and folds into a start sheet below it, opened by a 32 px\n  menu button; the theme toggle and the account menu sit at the end. With a\n  sidebar the trigger follows the lockup at every width, the sidebar holds\n  the navigation and the account, and the header is sticky (z-20, under\n  every overlay), since the sidebar beside it is sticky too. Without one,\n  not sticky by default.\n-->\n<header\n  data-slot=\"app-shell-header\"\n  class={cn(\n    \"groove-b bg-background\",\n    sidebar && \"sticky top-0 z-20\",\n    sticky && !sidebar && \"sticky top-0 z-40\",\n    className,\n  )}\n>\n  <div class=\"mx-auto flex h-16 max-w-5xl items-center gap-4 px-6\">\n    <Lockup href=\"/\" label={appName} entrance class=\"text-2xl\" />\n    {#if sidebar}\n      <SidebarTrigger />\n    {:else}\n      <AppShellNav {links} {current} class=\"hidden md:flex\" />\n    {/if}\n    <div class=\"ms-auto flex items-center gap-2\">\n      <ThemeToggle size=\"icon-sm\" />\n      {#if user && !sidebar}\n        <AppShellUserMenu {user} {settingsHref} {signOutHref} />\n      {/if}\n      {#if !sidebar}\n        <Sheet.Root bind:open={menuOpen}>\n          <Sheet.Trigger>\n            {#snippet child({ props })}\n              <Button\n                {...props}\n                variant=\"ghost\"\n                size=\"icon-sm\"\n                aria-label=\"Menu\"\n                class=\"md:hidden\"\n                data-shell=\"menu-button\"\n              >\n                <List aria-hidden=\"true\" />\n              </Button>\n            {/snippet}\n          </Sheet.Trigger>\n          <Sheet.Content side=\"start\" data-shell=\"menu\">\n            <Sheet.Header class=\"sr-only\">\n              <Sheet.Title>{appName}</Sheet.Title>\n            </Sheet.Header>\n            <AppShellNav {links} {current} vertical />\n            {#if user}\n              <div class=\"groove flex flex-col items-start pt-6 text-sm\">\n                <span>{user.name}</span>\n                <Button\n                  variant=\"link\"\n                  href={signOutHref}\n                  class=\"text-foreground\"\n                >\n                  Sign out\n                </Button>\n              </div>\n            {/if}\n          </Sheet.Content>\n        </Sheet.Root>\n      {/if}\n    </div>\n  </div>\n</header>\n",
			"type": "registry:component",
			"target": "app-shell-header.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  /** One primary link: its visible label and its href. */\n  export type AppShellLink = { label: string; href: string };\n</script>\n\n<script lang=\"ts\">\n  import { Button } from \"$UI$/button\";\n  import { cn } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    links,\n    current,\n    label = \"Primary\",\n    vertical = false,\n    class: className,\n    ...restProps\n  }: HTMLAttributes<HTMLElement> & {\n    links: AppShellLink[];\n    /** The current page's href, from `page.url`: it gets `aria-current=\"page\"` and the underline. */\n    current?: string;\n    /** The landmark's name. */\n    label?: string;\n    /** A column, for the phone's sheet. */\n    vertical?: boolean;\n  } = $props();\n</script>\n\n<!--\n  A navigation landmark of text links, 48 px tall with no side padding, in\n  the foreground colour. The current page is told by aria-current and an\n  underline, so the state is shape, not colour. The bracketed variant:\n  Tailwind's aria-current: matches only aria-current=\"true\".\n-->\n<nav\n  data-slot=\"app-shell-nav\"\n  aria-label={label}\n  class={cn(className)}\n  {...restProps}\n>\n  <ul\n    class={cn(\"flex\", vertical ? \"flex-col items-start\" : \"items-center gap-6\")}\n  >\n    {#each links as link (link.href)}\n      <li>\n        <Button\n          variant=\"link\"\n          href={link.href}\n          aria-current={current === link.href ? \"page\" : undefined}\n          class=\"text-foreground no-underline aria-[current=page]:underline\"\n        >\n          {link.label}\n        </Button>\n      </li>\n    {/each}\n  </ul>\n</nav>\n",
			"type": "registry:component",
			"target": "app-shell-nav.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n  /** The signed-in person, as the menu shows them. */\n  export type AppShellUser = { name: string; email: string };\n\n  /** The avatar's fallback: the first letter of the first two words of the name. */\n  export function initials(name: string): string {\n    return name\n      .split(/\\s+/)\n      .filter(Boolean)\n      .slice(0, 2)\n      .map((word) => word[0]!.toUpperCase())\n      .join(\"\");\n  }\n</script>\n\n<script lang=\"ts\">\n  import Gear from \"phosphor-svelte/lib/Gear\";\n  import SignOut from \"phosphor-svelte/lib/SignOut\";\n  import * as Avatar from \"$UI$/avatar\";\n  import { Button } from \"$UI$/button\";\n  import * as DropdownMenu from \"$UI$/dropdown-menu\";\n  import type { Snippet } from \"svelte\";\n\n  let {\n    user,\n    settingsHref = \"/\",\n    signOutHref = \"/\",\n    trigger,\n  }: {\n    user: AppShellUser;\n    /** Your settings route. */\n    settingsHref?: string;\n    /** Your sign-out route. */\n    signOutHref?: string;\n    /** Another trigger, such as a sidebar row, given the menu's props; the default is the avatar in a 32 px button. */\n    trigger?: Snippet<[{ props: Record<string, unknown> }]>;\n  } = $props();\n</script>\n\n<!--\n  The account menu: a 24 px avatar with the person's initials, hidden from\n  the name, in a 32 px ghost button whose hidden text names it \"Account\n  menu\". Inside, a group\n  headed by the name and email, then Settings and Sign out, each a link\n  through the item's child snippet so the role stays menuitem. No\n  destructive styling on Sign out: leaving is not destroying.\n-->\n<DropdownMenu.Root>\n  <DropdownMenu.Trigger>\n    {#snippet child({ props })}\n      {#if trigger}\n        {@render trigger({ props })}\n      {:else}\n        <Button\n          {...props}\n          variant=\"ghost\"\n          size=\"icon-sm\"\n          data-shell=\"user-menu-trigger\"\n        >\n          <!-- The name comes from content, not aria-label: the initials are visible text, which a label would have to repeat (SC 2.5.3). -->\n          <Avatar.Root size=\"sm\" aria-hidden=\"true\">\n            <Avatar.Fallback>{initials(user.name)}</Avatar.Fallback>\n          </Avatar.Root>\n          <span class=\"sr-only\">Account menu</span>\n        </Button>\n      {/if}\n    {/snippet}\n  </DropdownMenu.Trigger>\n  <DropdownMenu.Content align=\"end\" data-shell=\"user-menu\">\n    <DropdownMenu.Group>\n      <DropdownMenu.GroupHeading class=\"h-auto flex-col items-start py-2\">\n        <span>{user.name}</span>\n        <span>{user.email}</span>\n      </DropdownMenu.GroupHeading>\n      <DropdownMenu.Item>\n        {#snippet child({ props })}\n          <a {...props} href={settingsHref}>\n            <Gear aria-hidden=\"true\" />\n            Settings\n          </a>\n        {/snippet}\n      </DropdownMenu.Item>\n      <DropdownMenu.Item>\n        {#snippet child({ props })}\n          <a {...props} href={signOutHref}>\n            <SignOut aria-hidden=\"true\" />\n            Sign out\n          </a>\n        {/snippet}\n      </DropdownMenu.Item>\n    </DropdownMenu.Group>\n  </DropdownMenu.Content>\n</DropdownMenu.Root>\n",
			"type": "registry:component",
			"target": "app-shell-user-menu.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import CaretRight from \"phosphor-svelte/lib/CaretRight\";\n  import Gear from \"phosphor-svelte/lib/Gear\";\n  import House from \"phosphor-svelte/lib/House\";\n  import Pulse from \"phosphor-svelte/lib/Pulse\";\n  import Users from \"phosphor-svelte/lib/Users\";\n  import type { AppShellLink } from \"$COMPONENTS$/app-shell-nav.svelte\";\n  import AppShellUserMenu, {\n    initials,\n    type AppShellUser,\n  } from \"$COMPONENTS$/app-shell-user-menu.svelte\";\n  import * as Avatar from \"$UI$/avatar\";\n  import * as Collapsible from \"$UI$/collapsible\";\n  import * as Sidebar from \"$UI$/sidebar\";\n\n  let {\n    links,\n    current,\n    user = null,\n    collapsible = \"offcanvas\",\n    heading = \"Workspace\",\n    preferences = [\n      { label: \"Profile\", href: \"#members\" },\n      { label: \"Notifications\", href: \"#members\" },\n    ],\n    settingsHref = \"/\",\n    signOutHref = \"/\",\n  }: {\n    /** The primary links, with the icons below by position. */\n    links: AppShellLink[];\n    /** The current page's href, from `page.url`. */\n    current?: string;\n    user?: AppShellUser | null;\n    /** Off-canvas (the default) or to icons; the shell's choice. */\n    collapsible?: \"offcanvas\" | \"icon\";\n    /** The section's name, in the heading face; not the lockup, which the header shows. */\n    heading?: string;\n    /** The sub-items of the Preferences group; replace their hrefs with your routes. */\n    preferences?: AppShellLink[];\n    settingsHref?: string;\n    signOutHref?: string;\n  } = $props();\n\n  // One icon per shipped link, by position. Give each of your links its own.\n  const ICONS = [House, Pulse, Users];\n</script>\n\n<!--\n  The shell's sidebar on 005's item: a nav landmark named \"Main\" with the\n  section's name, a search field, two groups with mono lowercase labels (the\n  links, then a collapsible Preferences group with its sub-items), and the\n  account row in its footer opening the account menu. The current row is\n  told by aria-current, the inset and the primary edge. From md it sits\n  under the sticky 64 px header: top-16, and 64 px of padding at the foot of\n  its h-svh box, so the account row ends at the viewport's bottom. Below md\n  it is the sheet the item provides, opened by the header's trigger.\n-->\n<Sidebar.Root label=\"Main\" {collapsible} class=\"md:top-16 md:pb-16\">\n  <Sidebar.Header>\n    <p\n      class=\"flex h-12 items-center px-3 font-heading text-base font-bold group-data-[collapsible=icon]:hidden\"\n    >\n      {heading}\n    </p>\n    <Sidebar.Input placeholder=\"Search\" aria-label=\"Search\" />\n  </Sidebar.Header>\n  <Sidebar.Content>\n    <Sidebar.Group>\n      <Sidebar.GroupLabel>workspace</Sidebar.GroupLabel>\n      <Sidebar.GroupContent>\n        <Sidebar.Menu>\n          {#each links as link, i (link.href)}\n            {@const Icon = ICONS[i]}\n            <Sidebar.MenuItem>\n              <Sidebar.MenuButton\n                isActive={current === link.href}\n                tooltipContent={link.label}\n              >\n                {#snippet child({ props })}\n                  <a {...props} href={link.href}>\n                    {#if Icon}\n                      <Icon aria-hidden=\"true\" />\n                    {/if}\n                    <span>{link.label}</span>\n                  </a>\n                {/snippet}\n              </Sidebar.MenuButton>\n            </Sidebar.MenuItem>\n          {/each}\n        </Sidebar.Menu>\n      </Sidebar.GroupContent>\n    </Sidebar.Group>\n    <Sidebar.Group>\n      <Sidebar.GroupLabel>settings</Sidebar.GroupLabel>\n      <Sidebar.GroupContent>\n        <Sidebar.Menu>\n          <Sidebar.MenuItem>\n            <Collapsible.Root class=\"group/collapsible\">\n              <Collapsible.Trigger>\n                {#snippet child({ props })}\n                  <Sidebar.MenuButton {...props} tooltipContent=\"Preferences\">\n                    <Gear aria-hidden=\"true\" />\n                    <span>Preferences</span>\n                    <CaretRight\n                      aria-hidden=\"true\"\n                      class=\"ms-auto transition group-data-[state=open]/collapsible:rotate-90\"\n                    />\n                  </Sidebar.MenuButton>\n                {/snippet}\n              </Collapsible.Trigger>\n              <Collapsible.Content>\n                <Sidebar.MenuSub>\n                  {#each preferences as item (item.label)}\n                    <Sidebar.MenuSubItem>\n                      <Sidebar.MenuSubButton href={item.href}>\n                        <span>{item.label}</span>\n                      </Sidebar.MenuSubButton>\n                    </Sidebar.MenuSubItem>\n                  {/each}\n                </Sidebar.MenuSub>\n              </Collapsible.Content>\n            </Collapsible.Root>\n          </Sidebar.MenuItem>\n        </Sidebar.Menu>\n      </Sidebar.GroupContent>\n    </Sidebar.Group>\n  </Sidebar.Content>\n  {#if user}\n    {@const account = user}\n    <Sidebar.Footer>\n      <Sidebar.Menu>\n        <Sidebar.MenuItem>\n          <AppShellUserMenu user={account} {settingsHref} {signOutHref}>\n            {#snippet trigger({ props })}\n              <Sidebar.MenuButton {...props} tooltipContent={account.name}>\n                <Avatar.Root size=\"sm\" aria-hidden=\"true\">\n                  <Avatar.Fallback>{initials(account.name)}</Avatar.Fallback>\n                </Avatar.Root>\n                <span>{account.name}</span>\n              </Sidebar.MenuButton>\n            {/snippet}\n          </AppShellUserMenu>\n        </Sidebar.MenuItem>\n      </Sidebar.Menu>\n    </Sidebar.Footer>\n  {/if}\n</Sidebar.Root>\n",
			"type": "registry:component",
			"target": "app-shell-sidebar.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { Lockup } from \"$UI$/four-dot\";\n  import { cn } from \"$UTILS$\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    commit,\n    builtAt,\n    docId,\n    sourceHref,\n    statement,\n    tagline = \"Work runs on data.\",\n    class: className,\n    ...restProps\n  }: HTMLAttributes<HTMLElement> & {\n    /** The build's commit, shown as given; without it, no row. */\n    commit?: string;\n    /** The commit's date, ISO 8601, shown as its date in a <time>; without it, no row. */\n    builtAt?: string;\n    /** The doc ID, `PS-<series>-<NNNN>`; without it, no row. */\n    docId?: string;\n    /** The site's own source; the link reads its host and path. */\n    sourceHref?: string;\n    /** One plain sentence under the rows, only when it is true; empty by default. */\n    statement?: string;\n    /** The brand line beside the lockup, which is the name; pass \"\" to show none. */\n    tagline?: string;\n  } = $props();\n\n  // The link's text: the host and path, never the scheme.\n  const sourceText = $derived.by(() => {\n    if (!sourceHref) return \"\";\n    try {\n      const url = new URL(sourceHref);\n      return `${url.host}${url.pathname.replace(/\\/$/, \"\")}`;\n    } catch {\n      return sourceHref;\n    }\n  });\n  const date = $derived(builtAt?.slice(0, 10));\n  const rows = $derived(Boolean(commit || builtAt || docId || sourceHref));\n</script>\n\n<!--\n  The contentinfo: the lockup (not a link; the header's is) with the brand\n  line beside it, and the build's furniture at the end in mono, lowercase\n  labels typed as such: commit, built, doc, source, each row only when its\n  value is given. The row wraps to one column on a phone. The build date on\n  every page meets v2's dating rule.\n-->\n<footer\n  data-slot=\"app-shell-footer\"\n  class={cn(\"groove bg-background\", className)}\n  {...restProps}\n>\n  <div class=\"mx-auto max-w-5xl px-6 pt-12 pb-16\">\n    <div class=\"flex flex-wrap items-center justify-between gap-6\">\n      <div class=\"flex flex-wrap items-baseline gap-x-4 gap-y-2\">\n        <Lockup class=\"text-2xl\" />\n        {#if tagline}\n          <p class=\"text-sm\">{tagline}</p>\n        {/if}\n      </div>\n      {#if rows}\n        <dl class=\"flex flex-col gap-1 font-mono text-xs text-muted-foreground\">\n          {#if commit}\n            <div class=\"flex gap-2\">\n              <dt class=\"w-16\">commit</dt>\n              <dd><code>{commit}</code></dd>\n            </div>\n          {/if}\n          {#if builtAt}\n            <div class=\"flex gap-2\">\n              <dt class=\"w-16\">built</dt>\n              <dd><time datetime={builtAt}>{date}</time></dd>\n            </div>\n          {/if}\n          {#if docId}\n            <div class=\"flex gap-2\">\n              <dt class=\"w-16\">doc</dt>\n              <dd>{docId}</dd>\n            </div>\n          {/if}\n          {#if sourceHref}\n            <div class=\"flex gap-2\">\n              <dt class=\"w-16\">source</dt>\n              <dd class=\"min-w-0\">\n                <a\n                  href={sourceHref}\n                  class=\"inline-flex min-h-6 items-center underline underline-offset-4 wrap-anywhere hover:text-foreground\"\n                >\n                  {sourceText}\n                </a>\n              </dd>\n            </div>\n          {/if}\n        </dl>\n      {/if}\n    </div>\n    {#if statement}\n      <p class=\"mt-6 text-sm\">{statement}</p>\n    {/if}\n  </div>\n</footer>\n",
			"type": "registry:component",
			"target": "app-shell-footer.svelte"
		}
	]
