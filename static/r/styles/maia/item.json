		{
			"content": "<script lang=\"ts\" module>\n  import { tv, type VariantProps } from \"tailwind-variants/lite\";\n\n  export const itemVariants = tv({\n    base: \"group/item flex w-full flex-wrap items-center rounded border text-sm transition-[background-color] [a]:hover:bg-accent\",\n    variants: {\n      variant: {\n        default: \"border-transparent\",\n        outline: \"border-border\",\n      },\n      size: {\n        default: \"gap-4 p-4\",\n        sm: \"gap-3 p-3\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n      size: \"default\",\n    },\n  });\n\n  export type ItemSize = VariantProps<typeof itemVariants>[\"size\"];\n  export type ItemVariant = VariantProps<typeof itemVariants>[\"variant\"];\n</script>\n\n<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import { getContext, type Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    child,\n    variant,\n    size,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n    child?: Snippet<[{ props: Record<string, unknown> }]>;\n    variant?: ItemVariant;\n    size?: ItemSize;\n  } = $props();\n\n  const inGroup = getContext<boolean | undefined>(\"pluto:item-group\") ?? false;\n\n  const mergedProps = $derived({\n    role: inGroup ? \"listitem\" : undefined,\n    class: cn(itemVariants({ variant, size }), className),\n    \"data-slot\": \"item\",\n    \"data-variant\": variant,\n    \"data-size\": size,\n    ...restProps,\n  });\n</script>\n\n{#if child}\n  {@render child({ props: mergedProps })}\n{:else}\n  <div bind:this={ref} {...mergedProps}>\n    {@render mergedProps.children?.()}\n  </div>\n{/if}\n",
