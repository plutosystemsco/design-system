		"stock": {
			"registry": "https://shadcn-svelte.com/registry/styles/maia",
			"item": "spinner",
			"cli": "1.7.1",
			"date": "2026-10-28",
			"sha256": "bdd31b9901948d74eb3f303ea7b2f5ac4fc1708e7dfc893b4948c9f543a6f4ba"
