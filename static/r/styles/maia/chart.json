	"files": [
		{
			"content": "<script lang=\"ts\">\n  import CaretRight from \"phosphor-svelte/lib/CaretRight\";\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import { setChartContext, type ChartConfig } from \"./chart-utils\";\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  const uid = $props.id();\n\n  let {\n    ref = $bindable(null),\n    id = uid,\n    class: className,\n    children,\n    config = {},\n    label,\n    captionHidden = false,\n    table,\n    ...restProps\n  }: WithElementRef<HTMLAttributes<HTMLElement>> & {\n    /** What the tooltip says about each series. */\n    config?: ChartConfig;\n    /** The figure's name, shown as its caption. Required: a chart's marks are invisible to assistive technology. */\n    label: string;\n    /** Keeps the caption for assistive technology only. */\n    captionHidden?: boolean;\n    /** The chart's data as a table, shown behind \"Show as table\": the keyboard and screen-reader path, and the only content a prerender holds. */\n    table?: Snippet;\n  } = $props();\n\n  const chartId = $derived(`chart-${(id ?? uid).replace(/:/g, \"\")}`);\n  const captionId = $derived(`${chartId}-caption`);\n\n  setChartContext({\n    get config() {\n      return config;\n    },\n  });\n</script>\n\n<!--\n  A figure named by its visible caption, which comes first:\n  a figcaption must be the figure's first or last child, and the table's\n  disclosure follows the chart. layerchart draws nothing on the server and\n  exposes only its tick labels, so the name and the table are what every\n  reader gets; the tooltip is the pointer's affordance.\n  Series take their colour from a token class or a var() prop on the mark;\n  the overrides below are the only styling this component does to layerchart.\n  Nothing animates: no mark here carries `motion`.\n-->\n<figure\n  bind:this={ref}\n  data-slot=\"chart\"\n  data-chart={chartId}\n  aria-labelledby={captionId}\n  class={cn(\n    \"grid w-full gap-2 text-xs\",\n    // Tick labels in the secondary ink; rules and grid lines as the hairline;\n    // no stroke on bars (layerchart's own default is a black 1 px line); the\n    // hover band (Highlight area) as the opaque muted inset, not layerchart's\n    // 5% tint of the foreground. Render the band before the marks.\n    \"[&_.lc-axis-tick-label]:fill-muted-foreground [&_.lc-axis-tick]:stroke-border [&_.lc-rule]:stroke-border [&_.lc-rule-x-line]:stroke-border [&_.lc-rule-y-line]:stroke-border [&_.lc-grid-x-line]:stroke-border [&_.lc-grid-y-line]:stroke-border [&_.lc-rect]:stroke-0 [&_.lc-highlight-area]:fill-muted [&_.lc-text]:text-xs [&_.lc-root-container]:w-full\",\n    className,\n  )}\n  {...restProps}\n>\n  <figcaption\n    id={captionId}\n    data-slot=\"chart-caption\"\n    class={cn(\"text-sm text-muted-foreground\", captionHidden && \"sr-only\")}\n  >\n    {label}\n  </figcaption>\n  <div data-slot=\"chart-box\" class=\"aspect-video w-full\">\n    {@render children?.()}\n  </div>\n  {#if table}\n    <details data-slot=\"chart-table\" class=\"group text-sm\">\n      <summary\n        class=\"inline-flex min-h-6 cursor-pointer items-center gap-2 text-muted-foreground\"\n      >\n        <!-- One caret, turned a quarter when open, as the accordion's is. -->\n        <CaretRight\n          aria-hidden=\"true\"\n          class=\"size-4 shrink-0 transition group-open:rotate-90\"\n        />\n        <span class=\"underline underline-offset-4\">Show as table</span>\n      </summary>\n      <div class=\"mt-2\">\n        {@render table()}\n      </div>\n    </details>\n  {/if}\n</figure>\n",
			"type": "registry:ui",
			"target": "chart/chart-container.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { getChartContext, Tooltip as TooltipPrimitive } from \"layerchart\";\n  import { cn, type WithElementRef, type WithoutChildren } from \"$UTILS$\";\n  import {\n    getPayloadConfigFromPayload,\n    useChart,\n    type TooltipPayload,\n  } from \"./chart-utils\";\n  import type { Snippet } from \"svelte\";\n  import type { HTMLAttributes } from \"svelte/elements\";\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  function defaultFormatter(value: any, _payload: TooltipPayload[]) {\n    return `${value}`;\n  }\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    hideLabel = false,\n    hideIndicator = false,\n    labelKey,\n    label,\n    labelFormatter = defaultFormatter,\n    labelClassName,\n    formatter,\n    nameKey,\n    ...restProps\n  }: WithoutChildren<WithElementRef<HTMLAttributes<HTMLDivElement>>> & {\n    hideLabel?: boolean;\n    label?: string;\n    nameKey?: string;\n    labelKey?: string;\n    hideIndicator?: boolean;\n    labelClassName?: string;\n    labelFormatter?:\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      | ((value: any, payload: TooltipPayload[]) => string | number | Snippet)\n      | null;\n    formatter?: Snippet<\n      [\n        {\n          value: unknown;\n          name: string;\n          item: TooltipPayload;\n          index: number;\n          payload: TooltipPayload[];\n        },\n      ]\n    >;\n  } = $props();\n\n  const chart = useChart();\n  const chartCtx = getChartContext();\n\n  // Only series with a value: an item chart gives the hovered item one.\n  const visibleSeries = $derived(\n    chartCtx.tooltip.series.filter(\n      (s: TooltipPayload) => s.value !== undefined,\n    ),\n  );\n\n  const formattedLabel = $derived.by(() => {\n    if (hideLabel || !visibleSeries?.length) return null;\n\n    const [item] = visibleSeries;\n    const tooltipData = chartCtx.tooltip.data;\n\n    // The x value of the hovered datum, such as a day or a date.\n    const dataLabel = tooltipData != null ? chartCtx.x(tooltipData) : undefined;\n\n    const key = labelKey ?? item?.label ?? item?.key ?? \"value\";\n    const itemConfig = getPayloadConfigFromPayload(\n      chart.config,\n      item,\n      key,\n      tooltipData as Record<string, unknown> | null,\n    );\n\n    let value: unknown;\n    if (!labelKey && typeof label === \"string\") {\n      value = chart.config[label as keyof typeof chart.config]?.label ?? label;\n    } else if (labelKey) {\n      value = itemConfig?.label ?? dataLabel;\n    } else {\n      value = dataLabel;\n    }\n\n    if (value === undefined) return null;\n    if (!labelFormatter) return value;\n    return labelFormatter(value, visibleSeries);\n  });\n</script>\n\n<!--\n  The pointer's affordance: a small panel raised by\n  elevation, as a popover is. Its indicator is a token class the series' config\n  names as `swatch`, rendered only when there is one, so no empty square and\n  no style attribute. The table under the figure is the keyboard path.\n-->\n<TooltipPrimitive.Root variant=\"none\">\n  <div\n    bind:this={ref}\n    data-slot=\"chart-tooltip\"\n    class={cn(\n      \"grid min-w-24 gap-2 rounded bg-popover px-3 py-2 text-xs text-popover-foreground shadow-elevation\",\n      className,\n    )}\n    {...restProps}\n  >\n    {#if formattedLabel}\n      <div class={cn(\"font-medium\", labelClassName)}>\n        {#if typeof formattedLabel === \"function\"}\n          {@render formattedLabel()}\n        {:else}\n          {formattedLabel}\n        {/if}\n      </div>\n    {/if}\n    <div class=\"grid gap-2\">\n      {#each visibleSeries as item, i (item.key + i)}\n        {@const key = `${nameKey || item.key || item.label || \"value\"}`}\n        {@const itemConfig = getPayloadConfigFromPayload(\n          chart.config,\n          item,\n          key,\n          chartCtx.tooltip.data,\n        )}\n        <div\n          class=\"flex w-full flex-wrap items-center gap-2 [&>svg]:size-4 [&>svg]:text-muted-foreground\"\n        >\n          {#if formatter && item.value !== undefined && item.label}\n            {@render formatter({\n              value: item.value,\n              name: item.label,\n              item,\n              index: i,\n              payload: visibleSeries,\n            })}\n          {:else}\n            {#if itemConfig?.icon}\n              <itemConfig.icon aria-hidden=\"true\" />\n            {:else if !hideIndicator && itemConfig?.swatch}\n              <div\n                aria-hidden=\"true\"\n                class={cn(\"size-2 shrink-0 rounded\", itemConfig.swatch)}\n              ></div>\n            {/if}\n            <div class=\"flex flex-1 items-center justify-between gap-4\">\n              <span class=\"text-muted-foreground\">\n                {itemConfig?.label || item.label}\n              </span>\n              {#if item.value !== undefined}\n                <span class=\"font-mono font-medium tabular-nums\">\n                  {item.value.toLocaleString()}\n                </span>\n              {/if}\n            </div>\n          {/if}\n        </div>\n      {/each}\n    </div>\n  </div>\n</TooltipPrimitive.Root>\n",
			"type": "registry:ui",
			"target": "chart/chart-tooltip.svelte"
		},
		{
			"content": "import { getContext, setContext, type Component } from \"svelte\";\nimport type { Tooltip } from \"layerchart\";\n\n/**\n * What a chart says about each of its series: a label, an\n * optional icon, and an optional `swatch`, a token class such as `bg-chart-1`\n * that the tooltip's indicator takes. A series' colour lives on its mark, as a\n * class or a `var()` prop, never in this config and never in a stylesheet.\n */\nexport type ChartConfig = {\n  [k in string]: {\n    label?: string;\n    icon?: Component;\n    /** A token class for the tooltip's indicator, such as `bg-chart-1`. */\n    swatch?: string;\n  };\n};\n\nexport type TooltipPayload = Tooltip.TooltipSeries;\n\n/** The config entry for a tooltip row: by its key, its label, or a string field of the datum. */\nexport function getPayloadConfigFromPayload(\n  config: ChartConfig,\n  payload: TooltipPayload,\n  key: string,\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  data?: Record<string, any> | null,\n) {\n  if (typeof payload !== \"object\" || payload === null) return undefined;\n\n  const payloadConfig =\n    \"config\" in payload &&\n    typeof payload.config === \"object\" &&\n    payload.config !== null\n      ? payload.config\n      : undefined;\n\n  let configLabelKey: string = key;\n\n  if (payload.key === key) {\n    configLabelKey = payload.key;\n  } else if (payload.label === key) {\n    configLabelKey = payload.label;\n  } else if (\n    key in payload &&\n    typeof payload[key as keyof typeof payload] === \"string\"\n  ) {\n    configLabelKey = payload[key as keyof typeof payload] as string;\n  } else if (\n    payloadConfig !== undefined &&\n    key in payloadConfig &&\n    typeof payloadConfig[key as keyof typeof payloadConfig] === \"string\"\n  ) {\n    configLabelKey = payloadConfig[key as keyof typeof payloadConfig] as string;\n  } else if (data != null && key in data && typeof data[key] === \"string\") {\n    configLabelKey = data[key] as string;\n  }\n\n  return configLabelKey in config\n    ? config[configLabelKey]\n    : config[key as keyof typeof config];\n}\n\ntype ChartContextValue = {\n  config: ChartConfig;\n};\n\nconst chartContextKey = Symbol(\"chart-context\");\n\nexport function setChartContext(value: ChartContextValue) {\n  return setContext(chartContextKey, value);\n}\n\nexport function useChart() {\n  return getContext<ChartContextValue>(chartContextKey);\n}\n",
			"type": "registry:ui",
			"target": "chart/chart-utils.ts"
		},
		{
			"content": "import ChartContainer from \"./chart-container.svelte\";\nimport ChartTooltip from \"./chart-tooltip.svelte\";\n\nexport { getPayloadConfigFromPayload, type ChartConfig } from \"./chart-utils\";\n\nexport {\n  ChartContainer,\n  ChartTooltip,\n  ChartContainer as Container,\n  ChartTooltip as Tooltip,\n};\n",
			"type": "registry:ui",
			"target": "chart/index.ts"
		}
	]
}