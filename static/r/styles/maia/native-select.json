		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLOptgroupAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLOptgroupAttributes> = $props();\n</script>\n\n<optgroup\n  bind:this={ref}\n  data-slot=\"native-select-optgroup\"\n  class={cn(\"bg-[Canvas] text-[CanvasText]\", className)}\n  {...restProps}\n>\n  {@render children?.()}\n</optgroup>\n",
			"type": "registry:ui",
			"target": "native-select/native-select-opt-group.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLOptionAttributes } from \"svelte/elements\";\n\n  let {\n    ref = $bindable(null),\n    class: className,\n    children,\n    ...restProps\n  }: WithElementRef<HTMLOptionAttributes> = $props();\n</script>\n\n<option\n  bind:this={ref}\n  data-slot=\"native-select-option\"\n  class={cn(\"bg-[Canvas] text-[CanvasText]\", className)}\n  {...restProps}\n>\n  {@render children?.()}\n</option>\n",
			"type": "registry:ui",
			"target": "native-select/native-select-option.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n  import CaretDownIcon from \"phosphor-svelte/lib/CaretDown\";\n  import { getContext } from \"svelte\";\n  import { cn, type WithElementRef } from \"$UTILS$\";\n  import type { HTMLSelectAttributes } from \"svelte/elements\";\n\n  /** The contract a `Field` sets under the key \"kuiper:field\". */\n  type FieldContext = {\n    readonly id: string;\n    readonly invalid: boolean;\n    readonly describedBy: string | undefined;\n  };\n\n  type NativeSelectProps = Omit<\n    WithElementRef<HTMLSelectAttributes, HTMLSelectElement>,\n    \"size\"\n  > & {\n    /** The chosen option's value. Bind it to read or set it. */\n    value?: HTMLSelectAttributes[\"value\"];\n    /**\n     * The control's id. Inside a `Field` it defaults to the field's, so the\n     * field's label points here.\n     */\n    id?: HTMLSelectAttributes[\"id\"];\n    /**\n     * The ids of the text that describes the control. Inside a `Field` it\n     * defaults to the field's description and error.\n     */\n    \"aria-describedby\"?: HTMLSelectAttributes[\"aria-describedby\"];\n    /**\n     * Marks the control invalid and draws its border in the destructive colour.\n     * Inside a `Field` it follows the field's `error` or `invalid`.\n     */\n    \"aria-invalid\"?: HTMLSelectAttributes[\"aria-invalid\"];\n  };\n\n  let {\n    ref = $bindable(null),\n    value = $bindable(),\n    class: className,\n    id,\n    \"aria-describedby\": describedBy,\n    \"aria-invalid\": invalid,\n    children,\n    ...restProps\n  }: NativeSelectProps = $props();\n\n  // A field from before 0.13.0 sets only its old key, read until 0.14.0.\n  const field =\n    getContext<FieldContext | undefined>(\"kuiper:field\") ??\n    getContext<FieldContext | undefined>(\"pluto:field\");\n</script>\n\n<div\n  class={cn(\n    \"group/native-select relative w-full has-[select:disabled]:opacity-50\",\n    className,\n  )}\n  data-slot=\"native-select-wrapper\"\n>\n  <select\n    bind:value\n    bind:this={ref}\n    data-slot=\"native-select\"\n    class=\"h-12 w-full min-w-0 appearance-none rounded border border-input bg-card pr-12 pl-3 text-base text-foreground transition-[color,background-color,border-color] select-none selection:bg-primary selection:text-primary-foreground aria-invalid:border-destructive disabled:pointer-events-none disabled:cursor-not-allowed\"\n    id={id ?? field?.id}\n    aria-describedby={describedBy ?? field?.describedBy}\n    aria-invalid={invalid ?? (field?.invalid ? true : undefined)}\n    {...restProps}\n  >\n    {@render children?.()}\n  </select>\n  <CaretDownIcon\n    class=\"pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-muted-foreground select-none\"\n    aria-hidden=\"true\"\n    data-slot=\"native-select-icon\"\n  />\n</div>\n",
			"type": "registry:ui",
			"target": "native-select/native-select.svelte"
		},
		{
			"content": "import OptGroup from \"./native-select-opt-group.svelte\";\nimport Option from \"./native-select-option.svelte\";\nimport Root from \"./native-select.svelte\";\n\nexport {\n  Root,\n  Option,\n  OptGroup,\n  Root as NativeSelect,\n  Option as NativeSelectOption,\n  OptGroup as NativeSelectOptGroup,\n};\n",
			"type": "registry:ui",
			"target": "native-select/index.ts"
		}
	]
