  "radius": { "case": 8 },
  "spacing": { "atom": 4, "ladder": [4, 8, 12, 16, 24, 32, 48, 64, 96] },
  "type": {
    "families": {
      "sans": {
        "variable": "--font-sans",
        "family": "'Geist Variable', system-ui, sans-serif",
        "package": "@fontsource-variable/geist",
        "item": "font-geist",
        "import": "Geist"
      },
      "heading": {
        "variable": "--font-heading",
        "family": "'IBM Plex Sans Variable', system-ui, sans-serif",
        "package": "@fontsource-variable/ibm-plex-sans",
        "item": "font-heading-ibm-plex-sans",
        "import": "IBM_Plex_Sans"
      },
      "mono": {
        "variable": "--font-mono",
        "family": "'JetBrains Mono Variable', ui-monospace, monospace",
        "package": "@fontsource-variable/jetbrains-mono",
        "item": "font-jetbrains-mono",
        "import": "JetBrains_Mono",
        "selector": "code, kbd, samp, pre"
      }
    },
    "scale": {
      "xs": { "px": 12, "lineHeight": 1.5 },
      "sm": { "px": 13.5, "lineHeight": 1.6 },
      "base": { "px": 16, "lineHeight": 1.6 },
      "2xl": { "px": 28, "lineHeight": 1.2 },
      "5xl": { "px": 44, "lineHeight": 1.15 }
    },
    "tracking": {
      "display": -0.03,
      "section": -0.02,
      "eyebrow": 0.08,
      "mark": -0.04
    },
    "weight": { "normal": 400, "medium": 500, "bold": 700 },
    "leading": { "none": 1 }
  },
  "motion": {
    "entranceMs": 900,
    "microMs": 200,
    "easeEntrance": [0.2, 0.7, 0.3, 1]
  },
  "mark": { "dot": 0.3, "gap": 0.08, "rise": 0.38, "lockupGap": 0.16 },
  "line": { "width": 1 },
  "focus": { "width": 2, "offset": 2 },
  "elevation": { "y": 12, "blur": 32 },
  "contrast": {
    "text": [
      ["foreground", "background"],
      ["card-foreground", "card"],
      ["popover-foreground", "popover"],
      ["secondary-foreground", "secondary"],
      ["foreground", "muted"],
      ["accent-foreground", "accent"],
      ["muted-foreground", "background"],
      ["muted-foreground", "card"],
      ["muted-foreground", "muted"],
      ["primary-foreground", "primary"],
      ["primary", "background"],
      ["primary", "card"],
      ["primary", "muted"],
      ["destructive", "background"],
      ["destructive", "card"],
      ["destructive", "muted"],
      ["destructive-foreground", "destructive"],
      ["success", "background"],
      ["success", "card"],
      ["success", "muted"],
      ["success-foreground", "success"],
      ["caution-foreground", "caution"],
      ["sidebar-foreground", "sidebar"],
      ["sidebar-primary-foreground", "sidebar-primary"],
      ["sidebar-accent-foreground", "sidebar-accent"],
      ["sidebar-primary", "sidebar"]
    ],
    "tints": [
      {
        "text": "destructive",
        "tint": "destructive",
        "over": "background",
        "alpha": { "light": 0.1, "dark": 0.2 }
      },
      {
        "text": "destructive",
        "tint": "destructive",
        "over": "card",
        "alpha": { "light": 0.1, "dark": 0.2 }
      },
      {
        "text": "success",
        "tint": "success",
        "over": "background",
        "alpha": { "light": 0.1, "dark": 0.2 }
      },
      {
        "text": "success",
        "tint": "success",
        "over": "card",
        "alpha": { "light": 0.1, "dark": 0.2 }
      }
    ],
    "nonText": [
      ["input", "background"],
      ["input", "card"],
      ["input", "muted"],
      ["ring", "background"],
      ["ring", "card"],
      ["sidebar-ring", "sidebar"],
      ["destructive-fill", "background"],
      ["destructive-fill", "card"],
      ["success-fill", "background"],
      ["success-fill", "card"],
      ["chart-1", "background"],
      ["chart-1", "card"],
      ["chart-2", "background"],
      ["chart-2", "card"],
      ["chart-3", "background"],
      ["chart-3", "card"],
      ["chart-4", "background"],
      ["chart-4", "card"],
      ["chart-5", "background"],
      ["chart-5", "card"]
    ],
    "exceptions": [
      {
        "theme": "light",
        "pair": ["chart-3", "background"],
        "why": "amber series are labelled directly (v2 §03; WCAG 1.4.11)"
      },
      {
        "theme": "light",
        "pair": ["chart-3", "card"],
        "why": "amber series are labelled directly (v2 §03; WCAG 1.4.11)"
      }
    ],
    "forbidden": [
      {
        "theme": "light",
        "text": "destructive",
        "tint": "destructive",
        "over": "muted",
        "alpha": 0.1,
        "ratio": 4.06,
        "why": "no state tint on muted (decision 8)"
      },
      {
        "theme": "dark",
        "text": "destructive",
        "tint": "destructive",
        "over": "muted",
        "alpha": 0.2,
        "ratio": 3.96,
        "why": "no state tint on muted (decision 8)"
      },
      {
        "theme": "dark",
        "text": "success",
        "tint": "success",
        "over": "muted",
        "alpha": 0.2,
        "ratio": 4.44,
        "why": "no state tint on muted (decision 8)"
      }
    ],
    "scrim": [
      {
        "theme": "light",
        "edge": "popover",
        "over": "background",
        "scrim": "scrim",
        "min": 3
      },
      {
        "theme": "light",
        "edge": "popover",
        "over": "card",
        "scrim": "scrim",
        "min": 3
      },
      {
        "theme": "light",
        "edge": "popover",
        "over": "muted",
        "scrim": "scrim",
        "min": 3
      },
      {
        "theme": "dark",
        "edge": "elevation-line",
        "over": "background",
        "scrim": "scrim",
        "min": 3
      },
      {
        "theme": "dark",
        "edge": "elevation-line",
        "over": "card",
        "scrim": "scrim",
        "min": 3
      },
      {
        "theme": "dark",
        "edge": "elevation-line",
        "over": "muted",
        "scrim": "scrim",
        "min": 3
      }
    ]
  }
}
