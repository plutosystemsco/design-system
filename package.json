{
  "name": "kuiper-design-system",
  "version": "0.13.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The Kuiper Design System, Pluto Systems' design system: tokens, styles and Svelte components, served as a shadcn-svelte registry.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": [
      "./src/lib/*",
      "./src/lib/*.ts",
      "./src/lib/*/index.ts"
    ]
  },
  "scripts": {
    "build:tokens": "bun scripts/build-tokens.ts",
    "build:registry": "bun scripts/build-registry.ts",
    "dev": "bun --bun vite dev",
    "build": "bun run build:tokens && bun run build:registry && bun --bun vite build && bun scripts/site/markdown.ts",
    "preview": "bun --bun vite preview",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "lint": "bun --bun prettier --check .",
    "test:unit": "bun test ./tests/unit",
    "test:e2e": "bun --bun playwright test",
    "test:smoke": "SMOKE_BLOCKS= bun test ./tests/smoke --timeout 300000",
    "test": "bun run test:unit && bun run test:e2e && bun run test:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@guidepup/guidepup": "0.40.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "1.64.1",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tree-sitter-grammars/tree-sitter-kotlin": "~1.1.0",
    "@tree-sitter-grammars/tree-sitter-svelte": "~1.0.2",
    "@tree-sitter-grammars/tree-sitter-toml": "^0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "^0.7.1",
    "@types/bun": "1.3.14",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "fontkit": "2.0.4",
    "layerchart": "^2.9.2",
    "phosphor-svelte": "^3.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "^1.7.1",
    "shiki": "^4.5.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wawoff2": "2.0.1",
    "web-tree-sitter": "^0.27.2"
  }
}
