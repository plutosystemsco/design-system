{
  "name": "pluto-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "The Pluto Systems design system: tokens, styles and Svelte components, served as a shadcn-svelte registry.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": [
      "./src/lib/*",
      "./src/lib/*.ts",
      "./src/lib/*/index.ts"
    ]
  },
  "scripts": {
    "build:tokens": "bun scripts/build-tokens.ts",
    "build:registry": "bun scripts/build-registry.ts",
    "dev": "bun --bun vite dev",
    "build": "bun run build:tokens && bun run build:registry && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "lint": "bun --bun prettier --check .",
    "test:unit": "bun test ./tests/unit",
    "test:e2e": "bun --bun playwright test",
    "test:smoke": "bun test ./tests/smoke --timeout 300000",
    "test": "bun run test:unit && bun run test:e2e && bun run test:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "cn": "^0.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "^1.7.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
